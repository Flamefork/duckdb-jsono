# name: test/sql/jsono_layout_revision.test
# description: A foreign layout revision is refused loudly on every reading path; transport still works
# group: [sql]

require jsono

require json

require parquet

# Closed-revision fixtures. A legacy value is assembled with a struct literal over a REAL current
# body, so no old build and no committed binary is needed: the fixture is text, diffs and reviews
# like code. Only the field NAMES matter here — that is what the refusal reads, before a blob is
# touched — so the bodies below are current bytes and carry no meaning of their own.

statement ok
CREATE TABLE src AS SELECT jsono('{"a":1,"b":"x"}', shredding := '{"a": "BIGINT"}') AS v;

# Revision 0, shredded: unrevisioned field names, and the pre-plan-054 lane shape
# (STRUCT(value, complete) pairs, no spill bitmap).
statement ok
CREATE TABLE rev0_shredded AS
SELECT {'jsono': {'body': v.jsono."body$1",
                  'shreds': {'$jsono$set': v.jsono."shreds$2"."$jsono$set",
                             'a': {'value': v.jsono."shreds$2".c4000, 'complete': true}}}} AS v
FROM src;

# Revision 0, plain: the body layout of that era happens to match this build's, which is exactly the
# trap — without a revision in the name nothing distinguishes it, and every reader would happily read
# a body whose encoding contract it does not actually know.
statement ok
CREATE TABLE rev0_plain AS SELECT {'jsono': {'body': v.jsono."body$1"}} AS v FROM src;

# The intermediate plan-054 shapes: bare lanes with a single unordinal spill column, then an ordinal
# family with a different spelling. Both were written by real builds between ada4d30 and cc7d8cb.
statement ok
CREATE TABLE rev0_bare_spill AS
SELECT {'jsono': {'body': v.jsono."body$1",
                  'shreds': {'$jsono$set': v.jsono."shreds$2"."$jsono$set",
                             '$jsono$spill': v.jsono."shreds$2"."$jsono$spill$0",
                             'a': v.jsono."shreds$2".c4000}}} AS v
FROM src;

# A future revision: the same anchor, a revision this build does not know. Two of them, one per
# stem, because they version independent things and each must be refused on its own: a future SHRED
# layout beside a current residual, and a future RESIDUAL layout beside current shreds.
statement ok
CREATE TABLE rev99 AS
SELECT {'jsono': {'body$1': v.jsono."body$1",
                  'shreds$99': {'$jsono$set': v.jsono."shreds$2"."$jsono$set",
                                '$jsono$spill$0': v.jsono."shreds$2"."$jsono$spill$0",
                                'a': v.jsono."shreds$2".c4000}}} AS v
FROM src;

statement ok
CREATE TABLE body_rev2 AS
SELECT {'jsono': {'body$2': v.jsono."body$1",
                  'shreds$1': {'$jsono$set': v.jsono."shreds$2"."$jsono$set",
                               '$jsono$spill$0': v.jsono."shreds$2"."$jsono$spill$0",
                               'a': v.jsono."shreds$2".c4000}}} AS v
FROM src;

# Shreds revision 1, closed by plan 056: a current residual beside the shred layout that named a lane
# by its path spelled as TEXT (`a` for the top-level key below; a nested lane of that era read
# `$.o.k`) rather than by the encoding of the path. The text name is what DuckDB's case-insensitive
# STRUCT matching could collapse, so the shape is refused rather than read — and the refusal is
# decided by the field NAME, before any lane name is looked at.
statement ok
CREATE TABLE shreds_rev1 AS
SELECT {'jsono': {'body$1': v.jsono."body$1",
                  'shreds$1': {'$jsono$set': v.jsono."shreds$2"."$jsono$set",
                               '$jsono$spill$0': v.jsono."shreds$2"."$jsono$spill$0",
                               'a': v.jsono."shreds$2".c4000}}} AS v
FROM src;

# --- Every reading path refuses, ours and core json's alike. Before this, the core-json paths
# returned NULL or serialized the raw blob struct: silent data loss. ---

statement error
SELECT jsono_validate(v) FROM rev0_shredded;
----
layout revision body=0 shreds=0

statement error
SELECT v ->> 'a' FROM rev0_shredded;
----
layout revision body=0 shreds=0

statement error
SELECT to_json(v) FROM rev0_shredded;
----
layout revision body=0 shreds=0

statement error
SELECT v::JSON FROM rev0_shredded;
----
layout revision body=0 shreds=0

statement error
SELECT json_extract_string(v, 'a') FROM rev0_shredded;
----
layout revision body=0 shreds=0

# The constructor must not treat a foreign JSONO value as an ordinary struct to wrap into a document.
statement error
SELECT jsono(v) FROM rev0_shredded;
----
layout revision body=0 shreds=0

statement error
SELECT jsono_transform(v, {'a': 'BIGINT'}) FROM rev0_shredded;
----
layout revision body=0 shreds=0

statement error
SELECT jsono_group_merge(v) FROM rev0_shredded;
----
layout revision body=0 shreds=0

statement error
SELECT jsono_merge_patch(v, jsono('{"c":1}')) FROM rev0_shredded;
----
jsono_merge_patch(): JSONO value carries layout revision body=0 shreds=0

# jsono_overlay shares merge_patch's bind, so the refusal must name the function actually called.
statement error
SELECT jsono_overlay(v, jsono('{"c":1}')) FROM rev0_shredded;
----
jsono_overlay(): JSONO value carries layout revision body=0 shreds=0

statement error
SELECT jsono_group_merge_max(v, 1) FROM rev0_shredded;
----
jsono_group_merge_max: JSONO value carries layout revision body=0 shreds=0

# The advisors resolve their argument themselves, so each has to refuse rather than report the shape
# complaint it would give for an ordinary struct.
statement error
SELECT jsono_suggest_shredding(v) FROM rev0_shredded;
----
jsono_suggest_shredding: JSONO value carries layout revision body=0 shreds=0

statement error
SELECT jsono_shred_stats(v) FROM rev0_shredded;
----
jsono_shred_stats: JSONO value carries layout revision body=0 shreds=0

statement error
SELECT jsono(v, shredding := '{"a": "BIGINT"}') FROM rev0_shredded;
----
jsono(value, shredding := ...): JSONO value carries layout revision body=0 shreds=0

# Inserting a foreign value into a current-revision column: the by-name struct cast would drop the
# whole document silently, so the cast's bind refuses.
statement ok
CREATE TABLE current_column (v STRUCT(jsono STRUCT("body$1" STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB))));

statement error
INSERT INTO current_column SELECT v FROM rev0_plain;
----
cast to JSONO: JSONO value carries layout revision body=0,

# Plain revision 0 is refused for the same reason, and the message names only the body revision
# because that value carries no shreds at all.
statement error
SELECT v ->> 'a' FROM rev0_plain;
----
layout revision body=0,

statement error
SELECT jsono_validate(v) FROM rev0_plain;
----
this build reads body=1 shreds=2

statement error
SELECT v ->> 'a' FROM rev0_bare_spill;
----
layout revision body=0 shreds=0

statement error
SELECT v ->> 'a' FROM rev99;
----
layout revision body=1 shreds=99

statement error
SELECT v ->> 'a' FROM body_rev2;
----
layout revision body=2 shreds=1

# jsono_layout_lanes refuses a foreign revision too. Its answer would otherwise be `[]` — the same
# answer a plain value gets — for a value that HAS lanes this build cannot name. Only
# jsono_layout_diagnose, which answers what the value is rather than what is in it, survives.
statement error
SELECT jsono_layout_lanes(v) FROM rev99;
----
layout revision body=1 shreds=99

query IIII
SELECT x.kind, x.reason, x.body_revision, x.shreds_revision
FROM (SELECT jsono_layout_diagnose(v) AS x FROM rev99);
----
foreign	layout revision body=1 shreds=99, this build reads body=1 shreds=2	1	99

statement error
SELECT v ->> 'a' FROM shreds_rev1;
----
layout revision body=1 shreds=1

statement error
SELECT to_json(v) FROM shreds_rev1;
----
layout revision body=1 shreds=1

# --- Split revisions: a value whose residual is current and whose shreds are foreign is refused,
# while a current plain value beside it keeps reading. This is the point of versioning `body$N` and
# `shreds$M` separately — a shred-layout change must not invalidate the plain data. ---

query I
SELECT jsono('{"a":1}') ->> 'a';
----
1

query I
SELECT to_json(jsono('{"a":1,"b":"x"}', shredding := '{"a": "BIGINT"}'));
----
{"a":1,"b":"x"}

# --- Binary transport lives: a bare column reference is not a read, so the data can always be moved
# out to a build that reads it. Only interpretation is refused. ---

query I
SELECT count(*) FROM (SELECT * FROM rev0_shredded);
----
1

statement ok
COPY rev0_shredded TO '__TEST_DIR__/rev0_shredded.parquet';

statement ok
CREATE TABLE rev0_copy AS SELECT * FROM rev0_shredded;

# --- …but rendering to TEXT is not transport. The CSV writer resolves the VARCHAR cast from the
# registry at execution time, with no expression in the plan for the pre-optimize walk to see, so the
# refusal has to live in the cast's own bind. Without it, `COPY … TO … (FORMAT CSV)` (and EXPORT
# DATABASE, whose default format is CSV) wrote the raw blob struct as text — an unrecoverable
# "backup", taken without an error, of exactly the data the refusal message tells you to back up —
# while `value::VARCHAR` on the same value threw. ---

statement error
COPY rev0_shredded TO '__TEST_DIR__/rev0_shredded.csv' (FORMAT CSV);
----
cast to VARCHAR: JSONO value carries layout revision body=0 shreds=0

statement error
SELECT v::VARCHAR FROM rev0_shredded;
----
cast to VARCHAR: JSONO value carries layout revision body=0 shreds=0

statement error
SELECT v::VARCHAR FROM rev0_plain;
----
cast to VARCHAR: JSONO value carries layout revision body=0,

# The current revision keeps rendering, through the same cast entry.
query I
SELECT v::VARCHAR FROM src;
----
{"a":1,"b":"x"}

# …and the refusal survives the Parquet round-trip, where a stored old file is the real scenario.
statement error
SELECT v ->> 'a' FROM '__TEST_DIR__/rev0_shredded.parquet';
----
layout revision body=0 shreds=0

# --- Mixed revisions in one scan are refused, not silently emptied, IN EITHER FILE ORDER.
# union_by_name merges the per-file schemas by name before the extension sees anything, so the merged
# layout carries both revisions' stems ("body$1", "shreds$2", "body", "shreds") ordered by which file
# came first. Reading only the leading stem made the classification order-dependent: the old file
# first was refused, the current file first passed the anchor, failed the grammar and went silently
# NotJsono — the whole scan, current rows included, then read as NULL through core json. A compat
# reader cannot fix a mixed scan either (there is no single revision to upgrade from) — read the files
# separately and UNION ALL the upgraded values. ---

statement ok
COPY src TO '__TEST_DIR__/current.parquet';

statement error
SELECT v ->> 'a' FROM read_parquet(['__TEST_DIR__/rev0_shredded.parquet', '__TEST_DIR__/current.parquet'], union_by_name := true);
----
layout revision body=0 shreds=0

# The other order: the refusal names the FOREIGN revision, not the leading one, so both orders read
# identically.
statement error
SELECT v ->> 'a' FROM read_parquet(['__TEST_DIR__/current.parquet', '__TEST_DIR__/rev0_shredded.parquet'], union_by_name := true);
----
layout revision body=0 shreds=0

statement error
SELECT to_json(v) FROM read_parquet(['__TEST_DIR__/current.parquet', '__TEST_DIR__/rev0_shredded.parquet'], union_by_name := true);
----
layout revision body=0 shreds=0

# A plain current file mixed with a plain revision-0 one carries two `body` stems and no `shreds` at
# all: the mixture is caught by the stem count, not by the shreds field.
statement ok
COPY rev0_plain TO '__TEST_DIR__/rev0_plain.parquet';

statement ok
COPY (SELECT jsono('{"a":1}') AS v) TO '__TEST_DIR__/current_plain.parquet';

statement error
SELECT v ->> 'a' FROM read_parquet(['__TEST_DIR__/current_plain.parquet', '__TEST_DIR__/rev0_plain.parquet'], union_by_name := true);
----
layout revision body=0,

# --- The anchor is narrow: a struct that merely has a field named `jsono` is still someone else's
# data and stays silent (NotJsono), not refused. ---

statement error
SELECT jsono_validate({'jsono': {'a': 1}});
----
argument must be JSONO

statement error
SELECT jsono_validate({'jsono': 42});
----
argument must be JSONO

query I
SELECT to_json({'jsono': {'a': 1}});
----
{"jsono":{"a":1}}

# A near-miss body (five blobs) under the CURRENT revision stays silent rather than refused: a type
# carrying this revision can fail the grammar through a legal value->SQL->value round-trip (DuckLake's
# inlined-data flush narrows an all-NULL spill column to SQLNULL), and refusing that would break a
# write path to catch a hand-built struct. Only a foreign REVISION is refused.
statement error
SELECT jsono_validate({'jsono': {'body$1': {'slots': ''::BLOB, 'key_heap': ''::BLOB, 'string_heap': ''::BLOB, 'skips': ''::BLOB, 'lengths': ''::BLOB}}});
----
argument must be JSONO

# A revision name must be canonical: `body$01` is not a revision spelling, so it is not the anchor
# and the value stays someone else's struct.
statement error
SELECT jsono_validate({'jsono': {'body$01': {'slots': ''::BLOB, 'key_heap': ''::BLOB, 'string_heap': ''::BLOB, 'skips': ''::BLOB, 'lengths': ''::BLOB, 'nums': ''::BLOB}}});
----
argument must be JSONO

# The anchor also requires field 0 to be a STRUCT of nothing but BLOBs. Without that requirement an
# ordinary user struct that merely spells `{'jsono': {'body': ...}}` was refused as JSONO data whose
# revision could not be read. The requirement is revision-neutral: every revision's residual is blob
# columns, so a genuinely foreign body still gets refused (see rev0_plain above).
query II
SELECT ({'jsono': {'body': 42}}).jsono.body, to_json({'jsono': {'body': 42}});
----
42	{"jsono":{"body":42}}

# --- Documented boundaries. Both are pre-existing gaps that the refusal cannot close without
# refusing legal work; docs/jsono_format.md "Layout revisions" states them. They are pinned here so
# that closing one goes red rather than unnoticed. ---

# 1. A foreign value nested in a field of another struct: the plan walk inspects a child expression's
# own type, not the types nested inside it. Tightening it would refuse reads of the SIBLING fields.
statement ok
CREATE TABLE nested_foreign AS
SELECT (ROW(ROW(ROW(ROW(v.jsono."body$1".slots, v.jsono."body$1".key_heap, v.jsono."body$1".string_heap,
                        v.jsono."body$1".skips, v.jsono."body$1".lengths, v.jsono."body$1".nums))), 7))
       ::STRUCT(payload STRUCT(jsono STRUCT(body STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB))), id INTEGER) AS x
FROM src;

query I
SELECT to_json(x)::VARCHAR LIKE '{"payload":{"jsono":{"body":{"slots":"JSNO%' FROM nested_foreign;
----
true

statement error
SELECT to_json(x.payload) FROM nested_foreign;
----
layout revision body=0,

# 2. With the extension optimizer disabled the plan walk does not run, so the core-json paths go
# quiet again. The casts and our own binders do not depend on the optimizer and still refuse.
statement ok
SET disabled_optimizers='extension';

query I
SELECT v ->> 'a' FROM rev0_plain;
----
NULL

statement error
SELECT v::VARCHAR FROM rev0_plain;
----
cast to VARCHAR: JSONO value carries layout revision body=0,

statement ok
RESET disabled_optimizers;

# --- The documented way forward (docs/jsono_format.md → "Revision history"). A PLAIN revision-0
# value — whose only difference is the field name, and the shape stored files overwhelmingly carry —
# is moved to the current revision by rebuilding the layout struct under the revisioned name, in SQL,
# with no per-row work. It needs the optimizer off for that one statement: the rebuild reads the
# foreign value with struct_extract, which is exactly what the plan walk refuses. Pinned because the
# doc promises it — a tightening of the refusal that also closed this path would leave a user holding
# old files with no way forward at all, and the suite would stay green.
# A SHREDDED old value has no such path: its lanes are named by their path spelled as text, so a
# rename of the struct fields alone leaves a lane set the grammar does not accept (asserted below).
# That is the whole reason the doc sends shredded old data through a re-ingest. ---

statement ok
CREATE TABLE rev0_renameable AS
SELECT {'jsono': {'body': jsono('{"a":1,"b":"x"}').jsono."body$1"}} AS v;

statement error
SELECT to_json(v) FROM rev0_renameable;
----
layout revision body=0,

statement ok
SET disabled_optimizers='extension';

statement ok
CREATE TABLE rev0_upgraded AS
SELECT {'jsono': {'body$1': v.jsono.body}} AS v FROM rev0_renameable;

statement ok
RESET disabled_optimizers;

# The upgraded value is the original in every respect: same type, same document.
query II
SELECT typeof(v) = jsono_storage_type(), to_json(v) FROM rev0_upgraded;
----
true	{"a":1,"b":"x"}

# Renaming a shredded old value's fields is NOT an upgrade: the text lane name is not a canonical
# encoded name, so the result is not recognized as JSONO at all.
statement ok
SET disabled_optimizers='extension';

statement ok
CREATE TABLE shreds_rev1_renamed AS
SELECT {'jsono': {'body$1': v.jsono."body$1",
                  'shreds$2': {'$jsono$set': v.jsono."shreds$2"."$jsono$set",
                               '$jsono$spill$0': v.jsono."shreds$2"."$jsono$spill$0",
                               'a': v.jsono."shreds$2".c4000}}} AS v
FROM src;

statement ok
RESET disabled_optimizers;

query I
SELECT jsono_layout_diagnose(v).kind FROM shreds_rev1_renamed;
----
not jsono

# --- The rename trap is loud on JSON reads, silent on recovery paths ---
#
# A user who hits the refusal above and follows "rebuild the layout struct in SQL" by renaming
# `shreds$<old>` to this revision's name gets a value that is no longer JSONO at all: the lane names
# are still the closed revision's. RECOGNITION still classifies it silently (it runs over every
# struct in every plan, and a type-only near-miss is what a legal DuckLake flush produces) — but a
# name that does not decode inside a fully-anchored type is a shape no legal write narrows into, so
# the optimizer refuses the JSON reads that would silently answer NULL for every path. Passthrough
# (SELECT *, COPY) and the ::VARCHAR render stay open, so the data can still be moved and recovered.
# The upgrade path is the old build, not a rename.
statement ok
CREATE TABLE renamed_revision AS
SELECT struct_pack("jsono" := struct_pack(
    "body$1"   := v.jsono."body$1",
    "shreds$2" := struct_pack(
        "$jsono$set"     := v.jsono."shreds$2"."$jsono$set",
        "$jsono$spill$0" := v.jsono."shreds$2"."$jsono$spill$0",
        "gclid"          := 'kept'))) AS j
FROM (SELECT jsono('{"gclid":"kept","r":1}', shredding := '{"gclid": "VARCHAR"}') AS v);

# jsono_layout_diagnose answers about types nothing else will touch. The anchor DID parse here — the
# revisions are this build's — which is what makes the failure a lane NAME rather than a foreign
# value, and the reason says which name.
query IIII
SELECT x.kind, x.body_revision, x.shreds_revision,
       starts_with(x.reason, 'field ''gclid'' is not a shred lane')
FROM (SELECT jsono_layout_diagnose(j) AS x FROM renamed_revision);
----
not jsono	1	2	true

# A JSON read of the renamed value is refused with the grammar's own reason instead of answering
# NULL for every path.
statement error
SELECT j ->> 'gclid' FROM renamed_revision;
----
field 'gclid' is not a shred lane

# Passthrough and the raw ::VARCHAR render stay open: the bytes can be moved and recovered.
query II
SELECT count(*), (j::VARCHAR) IS NOT NULL FROM renamed_revision GROUP BY 2;
----
1	true
