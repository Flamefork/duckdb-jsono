# name: test/sql/jsono_shredded_cast_guard.test
# description: casts between differently-shredded JSONO types are lossless with the extension optimizer (reconstruct + reshred); without it the raw by-name struct cast drops shreds, and the shred manifest stored in the residual turns every read of such a narrowed row into a loud error instead of silent data loss
# group: [sql]

require jsono

require json

statement ok
CREATE TABLE shred_ab AS SELECT jsono('{"a":"AAA","b":"BBB"}', shredding := '{"a": "VARCHAR", "b": "VARCHAR"}') AS e;

statement ok
INSERT INTO shred_ab SELECT jsono('{"a":"CCC","b":"DDD"}', shredding := '{"a": "VARCHAR", "b": "VARCHAR"}');

# The same shred set in reverse spec order produces the same canonical type (specs are sorted),
# so it inserts directly.
statement ok
INSERT INTO shred_ab SELECT jsono('{"a":"EEE","b":"FFF"}', shredding := '{"b": "VARCHAR", "a": "VARCHAR"}');

# An overlapping shred set is NOT an error: the optimizer rewrites the lossy by-name cast into
# reconstruct + reshred against the target spec, so the value lands losslessly — a path with no
# shred in the target falls back into the residual.
statement ok
INSERT INTO shred_ab SELECT jsono('{"a":"q"}', shredding := '{"a": "VARCHAR"}');

statement ok
INSERT INTO shred_ab SELECT jsono('{"a":"1","b":"x"}', shredding := '{"a": "BIGINT", "b": "VARCHAR"}');

statement ok
INSERT INTO shred_ab SELECT jsono('{"a":"AAA","b":"BBB"}');

# A FULLY DISJOINT shred set works too: the shreds sit beside `body` inside the layout struct,
# so `body` is a field every two JSONO types share and the struct cast always binds — the
# optimizer then rewrites it into the same lossless reconstruct + reshred.
statement ok
INSERT INTO shred_ab SELECT jsono('{"x":"y"}', shredding := '{"x": "VARCHAR"}');

query I
SELECT to_json(e)::VARCHAR FROM shred_ab ORDER BY 1;
----
{"a":"1","b":"x"}
{"a":"AAA","b":"BBB"}
{"a":"AAA","b":"BBB"}
{"a":"CCC","b":"DDD"}
{"a":"EEE","b":"FFF"}
{"a":"q"}
{"x":"y"}

query II
SELECT e ->> 'a', e ->> 'x' FROM shred_ab ORDER BY 1 NULLS LAST, 2;
----
1	NULL
AAA	NULL
AAA	NULL
CCC	NULL
EEE	NULL
q	NULL
NULL	y

# Shredded -> plain JSON is the lossless reconstruction path; never blocked.
query I
SELECT to_json(jsono('{"a":"AAA","b":"BBB"}', shredding := '{"a": "VARCHAR"}'));
----
{"a":"AAA","b":"BBB"}

# --- Without the extension optimizer the raw by-name struct cast runs as core DuckDB binds it.
# A widening cast (target carries more shreds) merely NULL-fills the new shreds — readers fall back
# to the residual, so the value stays exact. A NARROWING cast drops a shred whose value was
# stripped out of the residual at write time; the shred manifest records that, and every read of
# such a row fails loud instead of silently losing the value. ---

statement ok
CREATE TABLE narrow_target AS SELECT jsono('{}', shredding := '{"a": "VARCHAR"}') AS e WHERE false;

statement ok
SET disabled_optimizers='extension';

statement ok
INSERT INTO narrow_target SELECT jsono('{"a":"v1","b":"v2"}', shredding := '{"a": "VARCHAR", "b": "VARCHAR"}');

statement ok
RESET disabled_optimizers;

# Reconstruction (to_json) of the narrowed row fails loud: the manifest lists shred 'b VARCHAR'
# but the column type no longer carries it.
statement error
SELECT to_json(e)::VARCHAR FROM narrow_target;
----
narrowed by a raw struct cast

# The dropped shred's path fails loud too (a silent NULL here would be the data loss).
statement error
SELECT e ->> 'b' FROM narrow_target;
----
narrowed by a raw struct cast

# The surviving shred still reads.
query I
SELECT e ->> 'a' FROM narrow_target;
----
v1

# Every other native reader of the narrowed row fails loud too (no silent partial output).
statement error
SELECT jsono_entries(e) FROM narrow_target;
----
narrowed by a raw struct cast

statement error
SELECT jsono_transform(e, {'b': 'VARCHAR'}) FROM narrow_target;
----
narrowed by a raw struct cast

statement error
SELECT jsono_keys(e) FROM narrow_target;
----
narrowed by a raw struct cast

statement error
SELECT to_json(jsono_merge_patch(e, jsono('{"z":"1"}'))) FROM narrow_target;
----
narrowed by a raw struct cast

statement error
SELECT jsono_group_merge(e) FROM narrow_target;
----
narrowed by a raw struct cast

# An honest row in the same narrow type reads fine alongside (the manifest check is per row).
statement ok
INSERT INTO narrow_target SELECT jsono('{"a":"ok","b":"kept"}', shredding := '{"a": "VARCHAR"}');

query I
SELECT e ->> 'a' FROM narrow_target ORDER BY 1;
----
ok
v1

# --- The newer readers fail loud on a narrowed row too, including one whose dropped shred is an
# ARRAY lane (the residual keeps only the element skeleton, so a silent read would fabricate
# placeholder content). ---

statement ok
CREATE TABLE narrow_arr AS SELECT jsono('{}', shredding := '{"a": "VARCHAR"}') AS e WHERE false;

statement ok
SET disabled_optimizers='extension';

statement ok
INSERT INTO narrow_arr SELECT jsono('{"a":"v","tags":[1,2]}', shredding := '{"a": "VARCHAR", "tags": "BIGINT[]"}');

statement ok
RESET disabled_optimizers;

statement error
SELECT jsono_array_length(e, '$.tags') FROM narrow_arr;
----
narrowed by a raw struct cast

statement error
SELECT jsono_array_elements(e, '$.tags') FROM narrow_arr;
----
narrowed by a raw struct cast

statement error
SELECT jsono_group_array(e) FROM narrow_arr;
----
narrowed by a raw struct cast

statement error
SELECT jsono_group_object('k', e) FROM narrow_arr;
----
narrowed by a raw struct cast

statement error
SELECT jsono_diff(e, e) FROM narrow_arr;
----
narrowed by a raw struct cast

# Shredded operations that the extension binds directly require the extension optimizer. Plain
# JSONO remains usable without it, but shredded values are unsafe because core DuckDB can
# otherwise route them through generic STRUCT casts.
statement ok
SET disabled_optimizers='extension';

statement error
SELECT jsono_extract(e, '$.a') FROM shred_ab;
----
requires the extension optimizer

statement error
SELECT jsono_storage_size(e) FROM shred_ab;
----
requires the extension optimizer

statement ok
RESET disabled_optimizers;

# The optimizer-injected expressions (__jsono_internal_checked_residual, the reshred rewrite)
# must survive plan (de)serialization — they are registered in the catalog and re-bind by name.
# Optimizer-injected functions that are not registered crash the DEBUG plan-serialize verifier.
statement ok
PRAGMA verify_serializer;

query I
SELECT e ->> 'b' FROM shred_ab WHERE e ->> 'a' = 'q';
----
NULL

statement ok
INSERT INTO narrow_target SELECT jsono('{"a":"ser","b":"ialized"}', shredding := '{"a": "VARCHAR", "b": "VARCHAR"}');

query I
SELECT to_json(e)::VARCHAR FROM narrow_target WHERE e ->> 'a' = 'ser';
----
{"a":"ser","b":"ialized"}

statement ok
PRAGMA disable_verification;

# --- A narrowed PLAIN value: repacking the residual body alone through a raw struct_pack keeps
# the shred manifest in skips but drops the shreds AND the shredded type. Every reader must fail
# loud on it, and the merge family must throw BEFORE rebuilding — a rebuilt blob would drop the
# manifest and launder the loss into permanent undetectability. ---

statement ok
CREATE TABLE plain_narrowed AS
SELECT struct_pack("jsono" := struct_pack("body$2" := j."jsono"."body$2")) AS p
FROM (SELECT jsono('{"a":"v1","b":"v2"}', shredding := '{"a": "VARCHAR"}') AS j);

statement error
SELECT to_json(p) FROM plain_narrowed;
----
narrowed by a raw struct cast

statement error
SELECT p::JSON FROM plain_narrowed;
----
narrowed by a raw struct cast

# The whole-keys form would silently lose the stripped key 'a'.
statement error
SELECT jsono_keys(p) FROM plain_narrowed;
----
narrowed by a raw struct cast

# A path the manifest covers reads as a silent NULL without the check.
statement error
SELECT jsono_type(p, '$.a') FROM plain_narrowed;
----
narrowed by a raw struct cast

# The root type is narrow-invariant (shred paths are object-key chains, so the root stays an
# object): the answer is complete and stays readable — same per-row granularity as extract.
query I
SELECT jsono_type(p) FROM plain_narrowed;
----
OBJECT

statement error
SELECT jsono_merge_patch(p, jsono('{}')) FROM plain_narrowed;
----
narrowed by a raw struct cast

statement error
SELECT jsono_group_merge(p) FROM plain_narrowed;
----
narrowed by a raw struct cast

# --- A structurally-present row whose `body` layout field is NULL (not the whole struct) is the
# trace of a by-name struct cast / set-op / CASE that NULL-fills a layout field. This is distinct
# from the shred-narrowing case above (body intact, shreds dropped): here `body` itself is absent,
# so the strict row reader (ReadJsonoRowStrict -> ThrowCorruptJsonoRow) fails loud BEFORE any
# value decode. Every reader inherits that throw; a NULL-body row must never read as `{}` / SQL
# NULL. A genuine all-NULL row (the whole struct is NULL) is a legal NULL and must stay NULL. ---

statement ok
CREATE TABLE null_body AS
SELECT struct_pack("jsono" := struct_pack("body$2" := NULL::STRUCT(
  slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB))) AS p;

statement error
SELECT to_json(p) FROM null_body;
----
body is NULL

statement error
SELECT p ->> 'a' FROM null_body;
----
body is NULL

statement error
SELECT jsono_keys(p) FROM null_body;
----
body is NULL

statement error
SELECT jsono_validate(p) FROM null_body;
----
body is NULL

# Same loud failure with the extension optimizer disabled (the no-optimizer read path).
statement ok
SET disabled_optimizers='extension';

statement error
SELECT to_json(p) FROM null_body;
----
body is NULL

statement ok
RESET disabled_optimizers;

# A set operation that NULL-fills a body branch produces the same NULL-body row and fails loud.
statement error
WITH u AS (
  SELECT jsono('{"a":"v1"}', shredding := '{"a": "VARCHAR"}') AS e
  UNION ALL
  SELECT struct_pack("jsono" := struct_pack("body$2" := NULL::STRUCT(
    slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB)))
)
SELECT to_json(e) FROM u;
----
body is NULL

# A genuine all-NULL row (the whole JSONO struct is NULL) is a legal SQL NULL, not corruption:
# the strict reader treats a NULL top-level struct as an absent value and every reader yields NULL.
statement ok
CREATE TABLE genuine_null AS
SELECT NULL::STRUCT("jsono" STRUCT("body$2" STRUCT(
  slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB))) AS p;

query III
SELECT to_json(p), p ->> 'a', jsono_validate(p) FROM genuine_null;
----
NULL	NULL	NULL

# The all-shredded merge fast path must verify each input's manifest against that input's own
# shreds: the narrowed row's manifest lists 'b VARCHAR' which no input carries, so the merge
# throws instead of re-emitting a manifest without it (laundering the loss).
statement error
SELECT jsono_merge_patch(e, jsono('{"z":"1"}', shredding := '{"z": "VARCHAR"}')) FROM narrow_target;
----
narrowed by a raw struct cast

# --- jsono_validate must report narrowed rows as invalid: the manifest lists a shred the column
# no longer carries, the same per-row condition every reader throws on. ---

# narrow_target: the narrowed row (a=v1) is false, the honest rows in the same column stay true.
query I
SELECT jsono_validate(e) FROM narrow_target ORDER BY e ->> 'a';
----
true
true
false

# A narrowed PLAIN value (residual repacked alone): the manifest survives in skips while the type
# carries no shreds at all.
query I
SELECT jsono_validate(p) FROM plain_narrowed;
----
false

# --- The optimizer's fused matcher/projector and the writers that re-emit a residual verify the
# manifest too: a narrowed row must fail loud wherever its stripped value would silently change
# the result or where a rebuilt blob would drop the manifest (laundering the loss). ---

# Fused filter matcher (two predicates on one column): the stripped path 'a' must not read as a
# silent non-match.
statement error
SELECT count(*) FROM plain_narrowed WHERE (p ->> 'a' = 'v1') AND (p ->> 'b' = 'v2');
----
narrowed by a raw struct cast

# Fused projector above a passing filter: the stripped path 'a' must not project a silent NULL.
statement error
SELECT min(p ->> 'a') FROM plain_narrowed WHERE (p ->> 'b' = 'v2') AND (p ->> 'b' IN ['v2', 'zz']);
----
narrowed by a raw struct cast

# Shredding a narrowed plain value re-emits the residual with a fresh manifest; without the check
# the stripped 'a' would become permanently undetectable.
statement error
SELECT jsono(p, shredding := '{"b": "VARCHAR"}') FROM plain_narrowed;
----
narrowed by a raw struct cast

# Embedding a narrowed value inside a constructed document re-emits it without its manifest.
statement error
SELECT to_json(jsono({'wrap': p})) FROM plain_narrowed;
----
narrowed by a raw struct cast

# Cast normalization into a target whose shred is an object array: the lane's TYPE carries encoded
# element-subfield names, so the reshred must be handed the type itself rather than a rendering of
# it — the injected expression declares its lanes structurally for exactly this reason.
statement ok
CREATE TABLE array_shredded AS
SELECT jsono('{"items":[{"id":1}],"o":"x"}', shredding := '{"$.items": "STRUCT(id BIGINT)[]"}') AS v;

statement ok
INSERT INTO array_shredded SELECT jsono('{"items":[{"id":2},{"id":3}],"o":"y"}');

query I
SELECT v::json::varchar FROM array_shredded ORDER BY 1;
----
{"items":[{"id":1}],"o":"x"}
{"items":[{"id":2},{"id":3}],"o":"y"}

# Two object-array lanes for one path whose element subfields differ ONLY in case. The codec keeps
# them apart in the stored type (the encoded alphabet has no upper case), and the set-op merge keeps
# both — but the reshred that coerces each branch to the merged type must not round-trip that type
# through text: DuckDB's type parser folds `id` and `ID` into one subfield, and the bind then fails
# on a type it cannot build. This is the read side of the same guarantee the lane names carry.
query I
SELECT to_json(v) FROM (
  SELECT jsono('{"items":[{"id":1}]}', shredding := '{"$.items": "STRUCT(id BIGINT)[]"}') AS v
  UNION ALL
  SELECT jsono('{"items":[{"ID":2}]}', shredding := '{"$.items": "STRUCT(ID BIGINT)[]"}')
) ORDER BY 1;
----
{"items":[{"ID":2}]}
{"items":[{"id":1}]}

# CASE reaches the same merged type through the binder rather than through set-op resolution.
query I
SELECT to_json(CASE WHEN i = 1
                    THEN jsono('{"items":[{"id":1}]}', shredding := '{"$.items": "STRUCT(id BIGINT)[]"}')
                    ELSE jsono('{"items":[{"ID":2}]}', shredding := '{"$.items": "STRUCT(ID BIGINT)[]"}') END)
FROM (SELECT unnest([1, 2]) AS i) ORDER BY 1;
----
{"items":[{"ID":2}]}
{"items":[{"id":1}]}

# The merged type carries BOTH subfields, each under its own encoded name. Note what the logical
# rendering below is: a type string DuckDB's own parser would collapse. That is exactly why the
# reshred takes the type structurally — and it is the one case where the lanes answer cannot be
# pasted back into a spec.
query II
SELECT l.path, l.type FROM (
  SELECT unnest(jsono_layout_lanes(v)) AS l FROM (
    SELECT jsono('{"items":[{"id":1}]}', shredding := '{"$.items": "STRUCT(id BIGINT)[]"}') AS v
    UNION ALL
    SELECT jsono('{"items":[{"ID":2}]}', shredding := '{"$.items": "STRUCT(ID BIGINT)[]"}')
  ) LIMIT 1
);
----
$.items	STRUCT(id BIGINT, ID BIGINT)[]

# --- An object-array lane's element struct may be WIDENED by name. This is what a multi-file scan
# does: read_parquet(union_by_name := true) unions the element structs of two files and NULL-fills
# the difference, and a NULL subfield means "not in the lane", which is where every reader already
# falls back to the residual skeleton. The manifest spells the stripped subfields out one by one for
# exactly this reason — as one rendered type string, "my subfield was dropped" and "another file's
# subfield was added beside mine" were the same inequality. ---

require parquet

statement ok
COPY (SELECT jsono('{"items":[{"id":1}]}', shredding := '{"$.items": "STRUCT(id BIGINT)[]"}') AS v)
TO '__TEST_DIR__/arr_id.parquet' (FORMAT PARQUET);

statement ok
COPY (SELECT jsono('{"items":[{"name":"n"}]}', shredding := '{"$.items": "STRUCT(name VARCHAR)[]"}') AS v)
TO '__TEST_DIR__/arr_name.parquet' (FORMAT PARQUET);

query I
SELECT to_json(v) FROM read_parquet(['__TEST_DIR__/arr_id.parquet', '__TEST_DIR__/arr_name.parquet'],
                                    union_by_name := true) ORDER BY 1;
----
{"items":[{"id":1}]}
{"items":[{"name":"n"}]}

# The same scan where the two subfields differ only in case: the encoded names keep them apart in
# the union, and each row still reads under the spelling it was written with.
statement ok
COPY (SELECT jsono('{"items":[{"ID":2}]}', shredding := '{"$.items": "STRUCT(ID BIGINT)[]"}') AS v)
TO '__TEST_DIR__/arr_upper.parquet' (FORMAT PARQUET);

query I
SELECT to_json(v) FROM read_parquet(['__TEST_DIR__/arr_id.parquet', '__TEST_DIR__/arr_upper.parquet'],
                                    union_by_name := true) ORDER BY 1;
----
{"items":[{"ID":2}]}
{"items":[{"id":1}]}

# Widening is accepted; NARROWING is still the loss the manifest exists to catch. A raw cast that
# drops a subfield the row stripped fails loud, and so does one that retypes it.
statement ok
CREATE TABLE arr_narrow AS SELECT jsono('{}', shredding := '{"$.items": "STRUCT(name VARCHAR)[]"}') AS v WHERE false;

statement ok
SET disabled_optimizers='extension';

statement ok
INSERT INTO arr_narrow
SELECT jsono('{"items":[{"id":7,"name":"n"}]}', shredding := '{"$.items": "STRUCT(id BIGINT, name VARCHAR)[]"}');

statement ok
RESET disabled_optimizers;

# The entry names the subfields the row actually stripped, so the message says which shape was
# written -- and it must differ from the retyped case below. Matched on the same substring, the two
# defects were one test: a reader that reported a DROPPED subfield as a RETYPED one, or the reverse,
# stayed green.
statement error
SELECT to_json(v) FROM arr_narrow;
----
shred '$.items STRUCT(id BIGINT, "name" VARCHAR)[]' but the column carries it as a different type

statement ok
CREATE TABLE arr_retyped AS SELECT jsono('{}', shredding := '{"$.items": "STRUCT(id VARCHAR)[]"}') AS v WHERE false;

statement ok
SET disabled_optimizers='extension';

statement ok
INSERT INTO arr_retyped SELECT jsono('{"items":[{"id":7}]}', shredding := '{"$.items": "STRUCT(id BIGINT)[]"}');

statement ok
RESET disabled_optimizers;

statement error
SELECT to_json(v) FROM arr_retyped;
----
shred '$.items STRUCT(id BIGINT)[]' but the column carries it as a different type

# The load-bearing line under the widening rule: a subfield that is NOT in the lane reads from the
# residual skeleton. The document below carries both `id` and `name` in its element while only `id`
# is shredded, so `name` sits in the skeleton — and it must still read through a widened union type,
# where the lane gained a `name` column of NULLs. If a reader ever took a NULL subfield for "the key
# is absent", this row is where it would lose data, and it is the row the relaxed check legalizes.
statement ok
COPY (SELECT jsono('{"items":[{"id":1,"name":"kept"}]}', shredding := '{"$.items": "STRUCT(id BIGINT)[]"}') AS v)
TO '__TEST_DIR__/arr_residual.parquet' (FORMAT PARQUET);

query II
SELECT to_json(v), v ->> '$.items[0].name'
FROM read_parquet(['__TEST_DIR__/arr_residual.parquet', '__TEST_DIR__/arr_name.parquet'],
                  union_by_name := true)
ORDER BY 1;
----
{"items":[{"id":1,"name":"kept"}]}	kept
{"items":[{"name":"n"}]}	n

# __jsono_internal_reshred is in the catalog so the injected expression re-binds by name after plan
# deserialization, which also makes it callable by hand. A wrong argument must be a BINDER error:
# an internal error aborts the caller's transaction over what is only a bad call.
statement error
SELECT __jsono_internal_reshred({'a': 1}, NULL);
----
the target must be a shredded jsono type

# Both type-answering functions re-bind once a prepared parameter has a type, rather than answering
# about UNKNOWN and freezing that answer into their bind data.
statement ok
PREPARE lanes_of AS SELECT jsono_layout_lanes($1);

query I
EXECUTE lanes_of(jsono('{"a":1}', shredding := '{"a": "BIGINT"}'));
----
[{'path': $.a, 'type': BIGINT}]

statement ok
PREPARE diagnose_of AS SELECT jsono_layout_diagnose($1).kind;

query I
EXECUTE diagnose_of(jsono('{"a":1}'));
----
plain

# --- The manifest's own text form quotes a subfield key, like every other type text does ---
#
# jsono_shred_manifest promises "the same type text the shredding spec takes", and the narrowing
# errors above quote the same rendering. A subfield key spelled raw turned a key holding a comma into
# a DIFFERENT valid type -- one subfield reported as two -- so the introspection lied and the two
# introspection functions disagreed about one lane.
query II
SELECT [m."type" FOR m IN jsono_shred_manifest(v)], [l."type" FOR l IN jsono_layout_lanes(v)]
FROM (SELECT jsono('{"items":[{"x BIGINT, y":"s"}]}',
                   shredding := '{"$.items": "STRUCT(\"x BIGINT, y\" VARCHAR)[]"}') AS v);
----
['STRUCT("x BIGINT, y" VARCHAR)[]']	['STRUCT("x BIGINT, y" VARCHAR)[]']

# --- __jsono_internal_checked_residual answers a wrong argument as a wrong argument ---
#
# It is in the catalog so the optimizer-injected expression can re-bind after plan deserialization,
# which also puts it within reach of a hand-written query. A NULL in the signature channel is a bad
# argument, not a broken invariant: raised as INTERNAL it aborts the caller's transaction over it.
statement error
SELECT __jsono_internal_checked_residual(
  jsono('{"a":1}'),
  [{'path': NULL::VARCHAR, 'type': 'BIGINT', 'subfields': []::STRUCT(key VARCHAR, "type" VARCHAR)[]}]);
----
Invalid Input Error

statement error
SELECT __jsono_internal_checked_residual(
  jsono('{"a":1}'),
  [{'path': '$.a', 'type': 'BIGINT', 'subfields': [NULL::STRUCT(key VARCHAR, "type" VARCHAR)]}]);
----
Invalid Input Error

statement error
SELECT __jsono_internal_checked_residual(jsono('{"a":1}'), NULL);
----
Invalid Input Error

# --- A path read of a narrowed row is judged against the path it reads, not the whole manifest ---
#
# The optimizer rewrites `->>` into a residual read whose narrowing verdict comes from the reader's
# point-read guard, so a read whose answer the narrowing cannot change is answered. This is the same
# verdict jsono_extract_string(e, path) has always given for the same read.

statement ok
CREATE TABLE narrow_scoped AS SELECT jsono('{}', shredding := '{"a": "VARCHAR"}') AS e WHERE false;

statement ok
SET disabled_optimizers='extension';

statement ok
INSERT INTO narrow_scoped SELECT jsono(
  '{"a":"v1","b":"v2","c":"v3","nest":{"deep":"v4"}}',
  shredding := '{"a": "VARCHAR", "b": "VARCHAR", "$.nest.deep": "VARCHAR"}');

statement ok
RESET disabled_optimizers;

# A key the narrowing never touched reads, spelled either way.
query I
SELECT e ->> 'c' FROM narrow_scoped;
----
v3

query I
SELECT jsono_extract_string(e, '$.c') FROM narrow_scoped;
----
v3

# The dropped shred's own path still fails loud.
statement error
SELECT e ->> 'b' FROM narrow_scoped;
----
narrowed by a raw struct cast

# So does a container read holding a dropped shred beneath it — the result would be missing it.
statement error
SELECT e -> 'nest' FROM narrow_scoped;
----
narrowed by a raw struct cast

# Whole-value readers still refuse the row outright: their answer is the whole document.
statement error
SELECT to_json(e)::VARCHAR FROM narrow_scoped;
----
narrowed by a raw struct cast

statement error
SELECT jsono_entries(e) FROM narrow_scoped;
----
narrowed by a raw struct cast
