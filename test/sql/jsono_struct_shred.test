# name: test/sql/jsono_struct_shred.test
# description: Shredding via the jsono(STRUCT) constructor (auto nested descend, collision, totality)
# group: [sql]

require jsono

require json

# One-pass shredded write: a NULL shred field stays in the residual as an explicit null
# (NULL shred = "value lives in the residual"), non-NULL shred fields are stripped and
# manifest-covered. Mixed NULL masks per row exercise the partial-strip emit.
query III
SELECT j.jsono."shreds$2".c4000, j.jsono."shreds$2".dc000, to_json(j)::VARCHAR
FROM (
    SELECT jsono(struct_pack(a := a, k := k)) AS j
    FROM (VALUES ('x', 1::BIGINT), (NULL, 2::BIGINT), ('z', NULL::BIGINT)) v(a, k)
) ORDER BY ALL;
----
x	1	{"a":"x","k":1}
z	NULL	{"a":"z","k":null}
NULL	2	{"a":null,"k":2}

# A field literally named like a JSONPath is an ordinary one-step path: a lane name is the encoding
# of the path, so the key `$.x` and the nested path $.x cannot share a name and the lane holds the
# literal key's value. (Under the text-named lanes this key minted the name `$.x`, which every reader
# then re-parsed as the nested path — the shred was permanently NULL and the value never lifted.)
query II
SELECT j.jsono."shreds$2"."4gn7g000", to_json(j)::VARCHAR FROM (SELECT jsono({'$.x': 'v', 'y': 1}) AS j);
----
v	{"$.x":"v","y":1}

# A `$`-leading field name that is NOT a path (`$x`) is a literal top-level key, and its lane holds
# the value. The lane name is decoded, never re-parsed as the shredding-spec DSL — the DSL reserves
# a leading `$` for the path form (a literal `$x` must be written `$."$x"` there), so re-parsing a
# minted lane name through it used to reject a lane the same bind had just put in the return type.
query II
SELECT j.jsono."shreds$2"."4hs0000", to_json(j)::VARCHAR FROM (SELECT jsono({'$x': 'v', 'y': 1}) AS j);
----
v	{"$x":"v","y":1}

# Type-driven auto-shred descends nested structs: a top-level scalar lifts under its one-step path,
# a scalar inside a nested STRUCT under its $.parent.child path. Every lane is named by the encoding
# of that path — the type text is base32hex, and jsono_layout_lanes is how it is read back. The shred
# set is a pure function of the input type (known at bind), so the constructor's return type carries
# them, sorted by name, which the codec makes the same as sorted by path.
query I
SELECT typeof(jsono({'did': 'd1', 'kind': 'k', 'commit': {'collection': 'coll', 'operation': 'create'}}));
----
STRUCT(jsono STRUCT("body$1" STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB), "shreds$2" STRUCT("$jsono$set" BIGINT, "$jsono$spill$0" BIGINT, cdnmqrb9eg000orfdhm6aorkd5nms000 VARCHAR, cdnmqrb9eg000rrgclp62t39dtn0000 VARCHAR, chkm8000 VARCHAR, ddkmsp0000 VARCHAR)))

# The walk descends nested structs up to a deliberately high cap (JSONO_AUTO_SHRED_MAX_DEPTH), well
# above realistic nesting, so every scalar leaf here lifts: $.b.c, $.b.d.e, and $.b.d.f.g. The cap
# only exists to stop a pathologically deep value from making reconstruct super-linear (see the
# depth-boundary case in jsono_struct_shred_depth.test).
query I
SELECT typeof(jsono({'a': 1::BIGINT, 'b': {'c': 'x', 'd': {'e': 'deep', 'f': {'g': 'deeper'}}}}));
----
STRUCT(jsono STRUCT("body$1" STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB), "shreds$2" STRUCT("$jsono$set" BIGINT, "$jsono$spill$0" BIGINT, c4000 BIGINT, c8000oo000 VARCHAR, c8000p0001ig000 VARCHAR, c8000p0001j000370000 VARCHAR)))

# The nested shreds round-trip losslessly.
query I
SELECT to_json(jsono({'a': 1::BIGINT, 'b': {'c': 'x', 'd': {'e': 'deep', 'f': {'g': 'deeper'}}}}))::VARCHAR;
----
{"a":1,"b":{"c":"x","d":{"e":"deep","f":{"g":"deeper"}}}}

# Nested auto-shred is lossless: the reconstructed document equals the plain parse, nesting intact.
query I
SELECT to_json(jsono({'did': 'd1', 'kind': 'k', 'commit': {'collection': 'coll', 'operation': 'create'}}))::VARCHAR;
----
{"commit":{"collection":"coll","operation":"create"},"did":"d1","kind":"k"}

# A nested NULL scalar stays an explicit null in the residual (NULL shred = value-in-residual);
# the typed nested shred captures the present value.
query III
SELECT j.jsono."shreds$2".cdnmqrb9eg000orfdhm6aorkd5nms000, j.jsono."shreds$2".cdnmqrb9eg000rg000, to_json(j)::VARCHAR
FROM (
    SELECT jsono({'commit': {'collection': c, 'n': n}}) AS j
    FROM (VALUES ('post', 1::BIGINT), (NULL, NULL::BIGINT)) v(c, n)
) ORDER BY ALL;
----
post	1	{"commit":{"collection":"post","n":1}}
NULL	NULL	{"commit":{"collection":null,"n":null}}

# A nested key carrying a path-structural character is emitted as a quoted path step and round-trips.
query I
SELECT to_json(jsono({'nest': {'a.b': 'v', 'c': 'plain'}}))::VARCHAR;
----
{"nest":{"a.b":"v","c":"plain"}}

# A bare top-level $.path read on a nested auto-shred resolves to the typed shred subcolumn (the
# optimizer's transparency rewrite matches the shred by its parsed path, not by field name string).
statement ok
CREATE TABLE nested_shred AS
SELECT jsono({'did': did, 'commit': {'collection': coll}}) AS j
FROM (VALUES ('d1', 'app.bsky.feed.post'), ('d2', 'app.bsky.feed.like'), ('d1', 'app.bsky.feed.post')) v(did, coll);

query II
SELECT j ->> '$.commit.collection' AS c, count(*) FROM nested_shred GROUP BY c ORDER BY c;
----
app.bsky.feed.like	1
app.bsky.feed.post	2

# The former shred-name collision is gone: a literal top-level key spelled as a JSON path
# ('$.commit.collection') and a nested scalar lifted to that same TEXT are two different PATHS, and a
# lane is named by the path's structure, so they encode to two names and both lift. This is what the
# codec removed structurally — the old build dropped both to the residual because one text name could
# not carry two lanes.
query I
SELECT jsono_layout_lanes(jsono({'$.commit.collection': 'flat', 'commit': {'collection': 'nested'}}));
----
[{'path': '$."$.commit.collection"', 'type': VARCHAR}, {'path': $.commit.collection, 'type': VARCHAR}]

# Both values round-trip.
query I
SELECT to_json(jsono({'$.commit.collection': 'flat', 'commit': {'collection': 'nested'}}))::VARCHAR;
----
{"$.commit.collection":"flat","commit":{"collection":"nested"}}

# Path resolution stays correct: $.commit.collection resolves the real nested path, while the
# literal top-level key is addressable via its escaped path step.
query II
SELECT j ->> '$.commit.collection' AS path_resolved, j ->> '$."$.commit.collection"' AS literal_key
FROM (SELECT jsono({'$.commit.collection': 'flat', 'commit': {'collection': 'nested'}}) AS j);
----
nested	flat

# A sibling next to them lifts as well — three lanes, no name in common.
query I
SELECT typeof(jsono({'$.commit.collection': 'flat', 'commit': {'collection': 'nested', 'operation': 'create'}}));
----
STRUCT(jsono STRUCT("body$1" STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB), "shreds$2" STRUCT("$jsono$set" BIGINT, "$jsono$spill$0" BIGINT, "4gn66rrddlkn8bj3dtm6opb3ehkmurg000" VARCHAR, cdnmqrb9eg000orfdhm6aorkd5nms000 VARCHAR, cdnmqrb9eg000rrgclp62t39dtn0000 VARCHAR)))

# Type-driven auto-shred is always complete: a shred's type IS its field's type, so a present
# value always fits and a NULL is only an absent field, never a residual diversion. A typed shred
# with absent (NULL) rows is therefore read COALESCE-free — the per-shred totality fast path that gives
# jsono(struct, shredding) the zone-map pushdown on read-back.
statement ok
CREATE TABLE sc_value_complete AS
SELECT jsono({'x': CASE WHEN i % 3 = 0 THEN NULL ELSE i END :: BIGINT, 'k': 'a'}) AS j
FROM range(3000) tt(i);

statement ok
PRAGMA explain_output='physical_only';

query II
EXPLAIN SELECT MIN(CAST(j->>'$.x' AS BIGINT)) FROM sc_value_complete;
----
physical_plan	<!REGEX>:.*COALESCE.*

statement ok
PRAGMA explain_output='all';

# 2000 of 3000 rows carry $.x (the others are NULL); MIN/MAX over the present integers.
query III
SELECT MIN(CAST(j->>'$.x' AS BIGINT)), MAX(CAST(j->>'$.x' AS BIGINT)), COUNT(CAST(j->>'$.x' AS BIGINT)) FROM sc_value_complete;
----
1	2999	2000
