# name: test/sql/jsono_shredded_funcs.test
# description: jsono read functions (extract, extract_string, type, keys) accept shredded input
# group: [sql]

require jsono

# Reconstruction rides core json's to_json(ANY) for the cross-checks below.
require json

# A shredded value with a typed shred ($.a BIGINT), a string shred (name) and a nested residual (b).
statement ok
CREATE TABLE t AS SELECT jsono('{"a":1,"b":{"c":2},"name":"x"}', shredding := '{"$.a": "BIGINT", "name": "VARCHAR"}') AS j;

# jsono_extract reads both a shred path and a residual path off the reconstructed document.
query II
SELECT to_json(jsono_extract(j, '$.a')), to_json(jsono_extract(j, '$.b')) FROM t;
----
1	{"c":2}

# jsono_extract_string: shred value, nested residual value, and a miss → NULL.
query III
SELECT jsono_extract_string(j, 'name'), jsono_extract_string(j, '$.b.c'), jsono_extract_string(j, '$.missing') FROM t;
----
x	2	NULL

# jsono_type with and without a path; the typed shred reports its scalar type.
query III
SELECT jsono_type(j), jsono_type(j, '$.b'), jsono_type(j, '$.a') FROM t;
----
OBJECT	OBJECT	BIGINT

# jsono_keys over the whole document (shreds + residual keys) and into a residual subobject.
query II
SELECT jsono_keys(j), jsono_keys(j, '$.b') FROM t;
----
[a, b, name]	[c]

# Each result equals the same call over the plain (non-shredded) equivalent document.
query IIIII
SELECT
  jsono_extract_string(j, 'name') = jsono_extract_string(p, 'name'),
  to_json(jsono_extract(j, '$.b')) = to_json(jsono_extract(p, '$.b')),
  jsono_type(j, '$.a') = jsono_type(p, '$.a'),
  jsono_keys(j) = jsono_keys(p),
  jsono_keys(j, '$.b') = jsono_keys(p, '$.b')
FROM t, (SELECT jsono('{"a":1,"b":{"c":2},"name":"x"}') AS p);
----
true	true	true	true	true

query I
SELECT jsono_keys(jsono('{"a":1,"m":2,"z":3}', shredding := '{"a":"BIGINT","z":"BIGINT"}'));
----
[a, m, z]

query II
SELECT jsono_keys(jsono('{"a":null,"b":"x"}', shredding := '{"a":"BIGINT","b":"VARCHAR","c":"BIGINT"}')),
       jsono_keys(jsono('{"a":"bad","b":"x","c":{"nested":1}}', shredding := '{"a":"BIGINT","b":"VARCHAR","c":"BIGINT"}'));
----
[a, b]	[a, b, c]

query III
SELECT jsono_keys(jsono('{"parent":{"child":1},"z":2}', shredding := '{"$.parent.child":"BIGINT","z":"BIGINT"}')),
       jsono_keys(jsono('{"arr":[1,2],"a":3}', shredding := '{"$.arr":"BIGINT[]","a":"BIGINT"}')),
       jsono_keys(jsono('{"objarr":[{"x":1}],"z":2}', shredding := '{"$.objarr":"STRUCT(x BIGINT)[]","z":"BIGINT"}'));
----
[parent, z]	[a, arr]	[objarr, z]

query III
SELECT jsono_keys(jsono(NULL::VARCHAR, shredding := '{"a":"BIGINT"}')),
       jsono_keys(jsono('1', shredding := '{"a":"BIGINT"}')),
       jsono_keys(jsono('{}', shredding := '{"a":"BIGINT"}'));
----
NULL	NULL	[]

query IIIII
SELECT jsono_array_length(jsono('[1,{"x":2},null]', shredding := '{"missing":"BIGINT"}')),
       jsono_array_length(jsono('{"arr":[1,2],"other":3}', shredding := '{"other":"BIGINT"}'), '$.arr'),
       jsono_array_length(jsono('{"arr":[1,2],"other":3}', shredding := '{"other":"BIGINT"}')),
       jsono_array_length(jsono('{"arr":[1,2],"other":3}', shredding := '{"other":"BIGINT"}'), '$.missing'),
       jsono_array_length(jsono(NULL::VARCHAR, shredding := '{"other":"BIGINT"}'), '$.arr');
----
3	2	NULL	NULL	NULL

query IIII
SELECT jsono_array_length(jsono('1', shredding := '{"missing":"BIGINT"}')),
       jsono_array_length(jsono('null', shredding := '{"missing":"BIGINT"}')),
       jsono_array_length(jsono('{"arr":{},"other":3}', shredding := '{"other":"BIGINT"}'), '$.arr'),
       jsono_array_length(jsono('{"arr":null,"other":3}', shredding := '{"other":"BIGINT"}'), '$.arr');
----
NULL	NULL	NULL	NULL

query III
SELECT jsono_array_length(jsono('{"arr":[1,2,3]}', shredding := '{"arr":"BIGINT"}'), '$.arr'),
       jsono_array_length(jsono('{"arr":[1,2,null]}', shredding := '{"$.arr":"BIGINT[]"}'), '$.arr'),
       jsono_array_length(jsono('{"arr":[1,2,null]}', shredding := '{"$.arr":"BIGINT[]"}'), '$.arr[0]');
----
3	3	NULL

query IIIIII
SELECT jsono_array_length(jsono('{"items":[{"x":1},{"x":2}]}', shredding := '{"$.items":"STRUCT(x BIGINT)[]"}'), '$.items'),
       jsono_array_length(jsono('{"items":[{"x":1},{"x":2}]}', shredding := '{"$.items":"STRUCT(x BIGINT)[]"}'), '$.items[0]'),
       jsono_array_length(jsono('{"items":[{"x":1},{"x":2}]}', shredding := '{"$.items":"STRUCT(x BIGINT)[]"}'), '$.items[0].x'),
       jsono_array_length(jsono('{"arr":[]}', shredding := '{"$.arr":"BIGINT[]"}'), '$.arr'),
       jsono_array_length(jsono('{"items":[]}', shredding := '{"$.items":"STRUCT(x BIGINT)[]"}'), '$.items'),
       jsono_array_length(jsono('{"arr":[1,2]}', shredding := '{"other":"BIGINT"}'), '$.arr') IS NOT DISTINCT FROM jsono_array_length(jsono('{"arr":[1,2]}'), '$.arr');
----
2	NULL	NULL	0	0	true

query I
SELECT jsono_array_length(jsono(
  '{"arr":[1,2,3],"k00":0,"k01":1,"k02":2,"k03":3,"k04":4,"k05":5,"k06":6,"k07":7,"k08":8,"k09":9,"k10":10,"k11":11,"k12":12,"k13":13,"k14":14,"k15":15,"k16":16,"k17":17,"k18":18,"k19":19,"k20":20,"k21":21,"k22":22,"k23":23,"k24":24,"k25":25,"k26":26,"k27":27,"k28":28,"k29":29,"k30":30,"k31":31,"k32":32,"k33":33,"k34":34,"k35":35,"k36":36,"k37":37,"k38":38,"k39":39,"k40":40,"k41":41,"k42":42,"k43":43,"k44":44,"k45":45,"k46":46,"k47":47,"k48":48,"k49":49,"k50":50,"k51":51,"k52":52,"k53":53,"k54":54,"k55":55,"k56":56,"k57":57,"k58":58,"k59":59,"k60":60,"k61":61,"k62":62,"k63":63}',
  shredding := '{"k00":"BIGINT","k01":"BIGINT","k02":"BIGINT","k03":"BIGINT","k04":"BIGINT","k05":"BIGINT","k06":"BIGINT","k07":"BIGINT","k08":"BIGINT","k09":"BIGINT","k10":"BIGINT","k11":"BIGINT","k12":"BIGINT","k13":"BIGINT","k14":"BIGINT","k15":"BIGINT","k16":"BIGINT","k17":"BIGINT","k18":"BIGINT","k19":"BIGINT","k20":"BIGINT","k21":"BIGINT","k22":"BIGINT","k23":"BIGINT","k24":"BIGINT","k25":"BIGINT","k26":"BIGINT","k27":"BIGINT","k28":"BIGINT","k29":"BIGINT","k30":"BIGINT","k31":"BIGINT","k32":"BIGINT","k33":"BIGINT","k34":"BIGINT","k35":"BIGINT","k36":"BIGINT","k37":"BIGINT","k38":"BIGINT","k39":"BIGINT","k40":"BIGINT","k41":"BIGINT","k42":"BIGINT","k43":"BIGINT","k44":"BIGINT","k45":"BIGINT","k46":"BIGINT","k47":"BIGINT","k48":"BIGINT","k49":"BIGINT","k50":"BIGINT","k51":"BIGINT","k52":"BIGINT","k53":"BIGINT","k54":"BIGINT","k55":"BIGINT","k56":"BIGINT","k57":"BIGINT","k58":"BIGINT","k59":"BIGINT","k60":"BIGINT","k61":"BIGINT","k62":"BIGINT","k63":"BIGINT"}'), '$.arr');
----
3

# Shredded operations require the extension optimizer: without it, core DuckDB can route
# differently-shredded values through generic STRUCT casts.
statement ok
SET disabled_optimizers='extension';

statement error
SELECT jsono_extract_string(j, 'name'), to_json(jsono_extract(j, '$.b')), jsono_type(j, '$.a'), jsono_keys(j) FROM t;
----
requires the extension optimizer

# The 2-arg path overloads of jsono_type/jsono_keys share one bind; the error must still name the
# specific function, confirming the shared bind reads bound_function.name rather than a hardcoded literal.
statement error
SELECT jsono_type(j, '$.a') FROM t;
----
jsono_type on shredded JSONO requires the extension optimizer

statement error
SELECT jsono_keys(j, '$.b') FROM t;
----
jsono_keys on shredded JSONO requires the extension optimizer

statement ok
RESET disabled_optimizers;

# A non-JSONO argument is rejected loudly at bind (ANY arg0 reaches the bind, which throws),
# rather than silently routed through the struct constructor cast.
statement error
SELECT jsono_extract(42, 'a');
----
jsono_extract: argument must be JSONO

statement error
SELECT jsono_extract_string('foo', 'a');
----
jsono_extract_string: argument must be JSONO

statement error
SELECT jsono_type({'a': 1});
----
jsono_type: argument must be JSONO

statement error
SELECT jsono_keys('foo');
----
jsono_keys: argument must be JSONO

# NULL input is accepted (plain path) and yields NULL.
query IIII
SELECT jsono_extract(NULL, '$.a'), jsono_extract_string(NULL, 'name'), jsono_type(NULL), jsono_keys(NULL);
----
NULL	NULL	NULL	NULL
