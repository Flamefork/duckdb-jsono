# name: test/sql/jsono_spill_semantics.test
# description: The $jsono$set / $jsono$spill$0 write discipline: a clean value row stamps the layout hash with a NULL spill, a dirty row the flipped hash with the mask of diverted-shred bits (sorted-name ranks), a SQL-NULL row NULLs both — across the text one-pass writer, the plain-jsono shred writer, the struct constructor and reshred.
# group: [sql]

require jsono

require json

# The per-row classes at one glance, spelled through the text one-pass writer. Shreds sorted by
# clean (no bit); a type-gate miss and a container at the path are spills. The two spec entries are
# spelled differently on purpose ('a' bare, '$.b' rooted): a lane is named by the encoding of its
# PATH, so the spelling no longer reaches the rank — the ranks are the paths' own order.
query IIII
SELECT j->>'a' AS a,
       j.jsono."shreds$2"."$jsono$spill$0" AS spill,
       j.jsono."shreds$2"."$jsono$set" = jsono('{"a":1,"b":2}', shredding := '{"a": "BIGINT", "$.b": "BIGINT"}').jsono."shreds$2"."$jsono$set" AS clean_marker,
       to_json(j)::VARCHAR AS rt
FROM (
  SELECT i, jsono(d, shredding := '{"a": "BIGINT", "$.b": "BIGINT"}') AS j FROM (VALUES
    (1, '{"a":1,"b":2}'),      -- both fit: clean
    (2, '{"b":2}'),            -- a absent: clean
    (3, '{"a":null,"b":2}'),   -- a explicit null: clean
    (4, '{"a":"x","b":2}'),    -- a diverts (rank 0): mask 1
    (5, '{"a":{"k":1},"b":2}'),-- a is a container (rank 0): mask 1
    (6, '{"a":1,"b":"x"}'),    -- b diverts (rank 1): mask 2
    (7, '{"a":"x","b":"y"}')   -- both divert: mask 3
  ) t(i, d)
) ORDER BY i;
----
1	NULL	1	{"a":1,"b":2}
NULL	NULL	1	{"b":2}
NULL	NULL	1	{"a":null,"b":2}
x	1	0	{"a":"x","b":2}
{"k":1}	1	0	{"a":{"k":1},"b":2}
1	2	0	{"a":1,"b":"x"}
x	3	0	{"a":"x","b":"y"}

# The dirty marker is exactly the clean hash with its lowest bit flipped.
query I
SELECT xor(d.jsono."shreds$2"."$jsono$set", c.jsono."shreds$2"."$jsono$set")
FROM (SELECT jsono('{"a":"x"}', shredding := '{"a": "BIGINT"}') AS d,
             jsono('{"a":1}', shredding := '{"a": "BIGINT"}') AS c);
----
1

# A SQL-NULL row NULLs the whole shreds subtree (marker, spill, lanes).
query III
SELECT j IS NULL, j.jsono."shreds$2"."$jsono$set" IS NULL, j.jsono."shreds$2"."$jsono$spill$0" IS NULL
FROM (SELECT jsono(NULL::VARCHAR, shredding := '{"a": "BIGINT"}') AS j);
----
true	true	true

# The plain-jsono shred writer (jsono(jsono, shredding :=)) stamps identically to the text path.
query II
SELECT j.jsono."shreds$2"."$jsono$spill$0",
       j = jsono('{"a":"x","b":2}', shredding := '{"a": "BIGINT", "$.b": "BIGINT"}')
FROM (SELECT jsono(jsono('{"a":"x","b":2}'), shredding := '{"a": "BIGINT", "$.b": "BIGINT"}') AS j);
----
1	true

# The struct constructor's auto-shred never diverts: clean marker, NULL spill on every row.
query II
SELECT j.jsono."shreds$2"."$jsono$spill$0" IS NULL,
       j.jsono."shreds$2"."$jsono$set" IS NOT NULL
FROM (SELECT jsono({'x': 5, 's': 'v'}) AS j);
----
true	true

# Reshred translates a kept shred's spill bit into the target set's rank numbering: the source has
# only `a` (dirty, bit 0); the widened target {a BIGINT, b VARCHAR} carries `a` at rank 0 too, and a
# fresh clean shred `b` — the mask stays 1 and the residual value still reads through the fallback.
query III
SELECT j.jsono."shreds$2"."$jsono$spill$0", j->>'a', j->>'b'
FROM (SELECT jsono(jsono('{"a":"x","b":"y"}', shredding := '{"a": "BIGINT"}'),
                   shredding := '{"a": "BIGINT", "b": "VARCHAR"}') AS j);
----
1	x	y

# Reshred re-numbering when ranks shift: source {z BIGINT} diverts (bit 0 of a 1-shred set);
# target {a VARCHAR, z BIGINT} lists z at rank 1 — the translated mask moves the bit.
query II
SELECT j.jsono."shreds$2"."$jsono$spill$0", j->>'z'
FROM (SELECT jsono(jsono('{"z":"str","a":"ok"}', shredding := '{"z": "BIGINT"}'),
                   shredding := '{"z": "BIGINT", "a": "VARCHAR"}') AS j);
----
2	str

# Dropping the diverted shred cleans the row: the value never left the residual, so the narrowed-set
# reshred is clean (no mask, clean marker).
query II
SELECT j.jsono."shreds$2"."$jsono$spill$0" IS NULL, j->>'a'
FROM (SELECT jsono(jsono('{"a":"x","b":1}', shredding := '{"a": "BIGINT", "b": "BIGINT"}'),
                   shredding := '{"b": "BIGINT"}') AS j);
----
true	x

# Array shreds never set spill bits: a diverted array path (a scalar there) keeps the row clean —
# the lane is NULL and readers always reconstruct arrays from the residual.
query II
SELECT j.jsono."shreds$2"."$jsono$spill$0" IS NULL, to_json(j)::VARCHAR
FROM (SELECT jsono('{"tags": 7}', shredding := '{"tags": "BIGINT[]"}') AS j);
----
true	{"tags":7}

# A set past 63 shreds grows a second spill column ("$jsono$spill$1"): the type carries ⌈N/63⌉
# bitmap columns, one bit per shred rank.
query II
SELECT jsono_storage_type('{"k00": "BIGINT", "k01": "BIGINT", "k02": "BIGINT", "k03": "BIGINT", "k04": "BIGINT", "k05": "BIGINT", "k06": "BIGINT", "k07": "BIGINT", "k08": "BIGINT", "k09": "BIGINT", "k10": "BIGINT", "k11": "BIGINT", "k12": "BIGINT", "k13": "BIGINT", "k14": "BIGINT", "k15": "BIGINT", "k16": "BIGINT", "k17": "BIGINT", "k18": "BIGINT", "k19": "BIGINT", "k20": "BIGINT", "k21": "BIGINT", "k22": "BIGINT", "k23": "BIGINT", "k24": "BIGINT", "k25": "BIGINT", "k26": "BIGINT", "k27": "BIGINT", "k28": "BIGINT", "k29": "BIGINT", "k30": "BIGINT", "k31": "BIGINT", "k32": "BIGINT", "k33": "BIGINT", "k34": "BIGINT", "k35": "BIGINT", "k36": "BIGINT", "k37": "BIGINT", "k38": "BIGINT", "k39": "BIGINT", "k40": "BIGINT", "k41": "BIGINT", "k42": "BIGINT", "k43": "BIGINT", "k44": "BIGINT", "k45": "BIGINT", "k46": "BIGINT", "k47": "BIGINT", "k48": "BIGINT", "k49": "BIGINT", "k50": "BIGINT", "k51": "BIGINT", "k52": "BIGINT", "k53": "BIGINT", "k54": "BIGINT", "k55": "BIGINT", "k56": "BIGINT", "k57": "BIGINT", "k58": "BIGINT", "k59": "BIGINT", "k60": "BIGINT", "k61": "BIGINT", "k62": "BIGINT", "k63": "BIGINT"}') LIKE '%"$jsono$spill$1" BIGINT%',
       jsono_storage_type('{"k00": "BIGINT", "k01": "BIGINT", "k02": "BIGINT"}') LIKE '%"$jsono$spill$1"%';
----
true	false

# A 64-shred value writes and reads through both spill columns: shred k63 (the highest rank, bit
# 0 of "$jsono$spill$1") diverts while k00 (bit 0 of "$jsono$spill$0") stays clean; the stamp, the
# reads and the validate discipline all hold across the column boundary.
statement ok
CREATE TABLE wide64 AS
SELECT jsono(d, shredding := '{"k00": "BIGINT", "k01": "BIGINT", "k02": "BIGINT", "k03": "BIGINT", "k04": "BIGINT", "k05": "BIGINT", "k06": "BIGINT", "k07": "BIGINT", "k08": "BIGINT", "k09": "BIGINT", "k10": "BIGINT", "k11": "BIGINT", "k12": "BIGINT", "k13": "BIGINT", "k14": "BIGINT", "k15": "BIGINT", "k16": "BIGINT", "k17": "BIGINT", "k18": "BIGINT", "k19": "BIGINT", "k20": "BIGINT", "k21": "BIGINT", "k22": "BIGINT", "k23": "BIGINT", "k24": "BIGINT", "k25": "BIGINT", "k26": "BIGINT", "k27": "BIGINT", "k28": "BIGINT", "k29": "BIGINT", "k30": "BIGINT", "k31": "BIGINT", "k32": "BIGINT", "k33": "BIGINT", "k34": "BIGINT", "k35": "BIGINT", "k36": "BIGINT", "k37": "BIGINT", "k38": "BIGINT", "k39": "BIGINT", "k40": "BIGINT", "k41": "BIGINT", "k42": "BIGINT", "k43": "BIGINT", "k44": "BIGINT", "k45": "BIGINT", "k46": "BIGINT", "k47": "BIGINT", "k48": "BIGINT", "k49": "BIGINT", "k50": "BIGINT", "k51": "BIGINT", "k52": "BIGINT", "k53": "BIGINT", "k54": "BIGINT", "k55": "BIGINT", "k56": "BIGINT", "k57": "BIGINT", "k58": "BIGINT", "k59": "BIGINT", "k60": "BIGINT", "k61": "BIGINT", "k62": "BIGINT", "k63": "BIGINT"}') AS j
FROM (VALUES ('{"k00": 7}'), ('{"k00": 7, "k63": "oops"}')) t(d);

query IIIII
SELECT j.jsono."shreds$2"."$jsono$spill$0", j.jsono."shreds$2"."$jsono$spill$1", j->>'k00', j->>'k63', jsono_validate(j)
FROM wide64 ORDER BY 3, 4;
----
0	1	7	oops	1
NULL	NULL	7	NULL	1


# A WIDE (>63 lanes) DIVERGENT set: k00..k62 plus the pair whose two orders disagree (see the
# divergent-pair block in jsono_layout_golden.test). Past 63 lanes a rank picks the spill COLUMN
# too (rank / 63), and the prod set-op bug this family guards against lived exactly in the wide
# mode. In encoded-name order the pair ranks 0 ($.a.b) and 1 ($.a-c) and k61/k62 overflow into
# "$jsono$spill$1" (ranks 63/64), while path-text order puts $.a-c first — a path-ranking bug
# renumbers the bits AND the column split here, which the same-order k00..k63 fixture above cannot
# see. A dirty row writes 0, not NULL, into the column carrying no diverted bit.
statement ok
CREATE TABLE wide_divergent AS
SELECT tag, jsono(d, shredding := '{"k00": "BIGINT", "k01": "BIGINT", "k02": "BIGINT", "k03": "BIGINT", "k04": "BIGINT", "k05": "BIGINT", "k06": "BIGINT", "k07": "BIGINT", "k08": "BIGINT", "k09": "BIGINT", "k10": "BIGINT", "k11": "BIGINT", "k12": "BIGINT", "k13": "BIGINT", "k14": "BIGINT", "k15": "BIGINT", "k16": "BIGINT", "k17": "BIGINT", "k18": "BIGINT", "k19": "BIGINT", "k20": "BIGINT", "k21": "BIGINT", "k22": "BIGINT", "k23": "BIGINT", "k24": "BIGINT", "k25": "BIGINT", "k26": "BIGINT", "k27": "BIGINT", "k28": "BIGINT", "k29": "BIGINT", "k30": "BIGINT", "k31": "BIGINT", "k32": "BIGINT", "k33": "BIGINT", "k34": "BIGINT", "k35": "BIGINT", "k36": "BIGINT", "k37": "BIGINT", "k38": "BIGINT", "k39": "BIGINT", "k40": "BIGINT", "k41": "BIGINT", "k42": "BIGINT", "k43": "BIGINT", "k44": "BIGINT", "k45": "BIGINT", "k46": "BIGINT", "k47": "BIGINT", "k48": "BIGINT", "k49": "BIGINT", "k50": "BIGINT", "k51": "BIGINT", "k52": "BIGINT", "k53": "BIGINT", "k54": "BIGINT", "k55": "BIGINT", "k56": "BIGINT", "k57": "BIGINT", "k58": "BIGINT", "k59": "BIGINT", "k60": "BIGINT", "k61": "BIGINT", "k62": "BIGINT", "$.\"a-c\"": "VARCHAR", "$.a.b": "VARCHAR"}') AS j FROM (VALUES
  ('all_fit', '{"k00": 0, "k01": 1, "k02": 2, "k03": 3, "k04": 4, "k05": 5, "k06": 6, "k07": 7, "k08": 8, "k09": 9, "k10": 10, "k11": 11, "k12": 12, "k13": 13, "k14": 14, "k15": 15, "k16": 16, "k17": 17, "k18": 18, "k19": 19, "k20": 20, "k21": 21, "k22": 22, "k23": 23, "k24": 24, "k25": 25, "k26": 26, "k27": 27, "k28": 28, "k29": 29, "k30": 30, "k31": 31, "k32": 32, "k33": 33, "k34": 34, "k35": 35, "k36": 36, "k37": 37, "k38": 38, "k39": 39, "k40": 40, "k41": 41, "k42": 42, "k43": 43, "k44": 44, "k45": 45, "k46": 46, "k47": 47, "k48": 48, "k49": 49, "k50": 50, "k51": 51, "k52": 52, "k53": 53, "k54": 54, "k55": 55, "k56": 56, "k57": 57, "k58": 58, "k59": 59, "k60": 60, "k61": 61, "k62": 62, "a-c": "x", "a": {"b": "y"}}'),
  ('ab_divert', '{"k00": 0, "k01": 1, "k02": 2, "k03": 3, "k04": 4, "k05": 5, "k06": 6, "k07": 7, "k08": 8, "k09": 9, "k10": 10, "k11": 11, "k12": 12, "k13": 13, "k14": 14, "k15": 15, "k16": 16, "k17": 17, "k18": 18, "k19": 19, "k20": 20, "k21": 21, "k22": 22, "k23": 23, "k24": 24, "k25": 25, "k26": 26, "k27": 27, "k28": 28, "k29": 29, "k30": 30, "k31": 31, "k32": 32, "k33": 33, "k34": 34, "k35": 35, "k36": 36, "k37": 37, "k38": 38, "k39": 39, "k40": 40, "k41": 41, "k42": 42, "k43": 43, "k44": 44, "k45": 45, "k46": 46, "k47": 47, "k48": 48, "k49": 49, "k50": 50, "k51": 51, "k52": 52, "k53": 53, "k54": 54, "k55": 55, "k56": 56, "k57": 57, "k58": 58, "k59": 59, "k60": 60, "k61": 61, "k62": 62, "a-c": "x", "a": {"b": {"q": 2}}}'),
  ('ac_divert', '{"k00": 0, "k01": 1, "k02": 2, "k03": 3, "k04": 4, "k05": 5, "k06": 6, "k07": 7, "k08": 8, "k09": 9, "k10": 10, "k11": 11, "k12": 12, "k13": 13, "k14": 14, "k15": 15, "k16": 16, "k17": 17, "k18": 18, "k19": 19, "k20": 20, "k21": 21, "k22": 22, "k23": 23, "k24": 24, "k25": 25, "k26": 26, "k27": 27, "k28": 28, "k29": 29, "k30": 30, "k31": 31, "k32": 32, "k33": 33, "k34": 34, "k35": 35, "k36": 36, "k37": 37, "k38": 38, "k39": 39, "k40": 40, "k41": 41, "k42": 42, "k43": 43, "k44": 44, "k45": 45, "k46": 46, "k47": 47, "k48": 48, "k49": 49, "k50": 50, "k51": 51, "k52": 52, "k53": 53, "k54": 54, "k55": 55, "k56": 56, "k57": 57, "k58": 58, "k59": 59, "k60": 60, "k61": 61, "k62": 62, "a-c": {"z": 1}, "a": {"b": "y"}}'),
  ('k62_divert', '{"k00": 0, "k01": 1, "k02": 2, "k03": 3, "k04": 4, "k05": 5, "k06": 6, "k07": 7, "k08": 8, "k09": 9, "k10": 10, "k11": 11, "k12": 12, "k13": 13, "k14": 14, "k15": 15, "k16": 16, "k17": 17, "k18": 18, "k19": 19, "k20": 20, "k21": 21, "k22": 22, "k23": 23, "k24": 24, "k25": 25, "k26": 26, "k27": 27, "k28": 28, "k29": 29, "k30": 30, "k31": 31, "k32": 32, "k33": 33, "k34": 34, "k35": 35, "k36": 36, "k37": 37, "k38": 38, "k39": 39, "k40": 40, "k41": 41, "k42": 42, "k43": 43, "k44": 44, "k45": 45, "k46": 46, "k47": 47, "k48": 48, "k49": 49, "k50": 50, "k51": 51, "k52": 52, "k53": 53, "k54": 54, "k55": 55, "k56": 56, "k57": 57, "k58": 58, "k59": 59, "k60": 60, "k61": 61, "k62": "oops", "a-c": "x", "a": {"b": "y"}}')
) t(tag, d);

query TIITTTI
SELECT tag, j.jsono."shreds$2"."$jsono$spill$0", j.jsono."shreds$2"."$jsono$spill$1",
       j ->> '$."a-c"', j ->> '$.a.b', j ->> 'k62', jsono_validate(j)
FROM wide_divergent ORDER BY tag;
----
ab_divert	1	0	x	{"q":2}	62	true
ac_divert	2	0	{"z":1}	y	62	true
all_fit	NULL	NULL	x	y	62	true
k62_divert	0	2	x	y	oops	true


require parquet

# The uniform dirty-mask quarantine survives a Parquet round-trip: rows where `n` diverts stamp the
# dirty marker with mask bit(n); the clean rows stamp the clean marker with NULL spill. The scan's
# marker min/max stay within the {clean, dirty} pair and the spill min==max decodes exactly, so the
# unrelated `$.URL.scheme` lane reads COALESCE-free off Parquet while `n` keeps its fallback.
statement ok
COPY (
  SELECT jsono(
    '{"URL":{"scheme":"' || (CASE WHEN i % 3 = 0 THEN 'goal' ELSE 'https' END) || '"}, "n": ' ||
    (CASE WHEN i % 100 = 8 THEN '"oops"' ELSE i::VARCHAR END) || '}',
    shredding := '{"$.URL.scheme": "VARCHAR", "n": "BIGINT"}') AS j
  FROM range(2000) tt(i)
) TO '__TEST_DIR__/spill_quarantine.parquet' (FORMAT parquet);

statement ok
PRAGMA explain_output='physical_only';

query II
EXPLAIN SELECT count(*) FROM read_parquet('__TEST_DIR__/spill_quarantine.parquet') WHERE j->>'$.URL.scheme' = 'goal';
----
physical_plan	<!REGEX>:.*COALESCE.*

query II
EXPLAIN SELECT MIN(TRY_CAST(j->>'n' AS BIGINT)) FROM read_parquet('__TEST_DIR__/spill_quarantine.parquet');
----
physical_plan	<REGEX>:.*COALESCE.*

statement ok
PRAGMA explain_output='all';

query III
SELECT count(*) FILTER (j->>'$.URL.scheme' = 'goal'),
       MIN(TRY_CAST(j->>'n' AS BIGINT)),
       count(*) FILTER (j->>'n' = 'oops')
FROM read_parquet('__TEST_DIR__/spill_quarantine.parquet');
----
667	0	20

# jsono_validate enforces the spill discipline: honest values pass; a forged mask on a clean-marker
# row, a hidden divert with a clean bit, and an out-of-domain mask are all invalid.
query IIII
SELECT jsono_validate(jsono('{"a":1}', shredding := '{"a": "BIGINT"}')),
       jsono_validate(jsono('{"a":"x"}', shredding := '{"a": "BIGINT"}')),
       jsono_validate(jsono('{"b":2}', shredding := '{"a": "BIGINT"}')),
       jsono_validate(jsono('{"a":null}', shredding := '{"a": "BIGINT"}'));
----
true	true	true	true

# Forged: clean marker but a mask present.
query I
SELECT jsono_validate(struct_pack(jsono := struct_pack(
  "body$2" := c.jsono."body$2",
  "shreds$2" := struct_pack(
    "$jsono$set" := c.jsono."shreds$2"."$jsono$set",
    "$jsono$spill$0" := 1::BIGINT,
    c4000 := c.jsono."shreds$2".c4000
  )))::STRUCT(jsono STRUCT("body$2" STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB), "shreds$2" STRUCT("$jsono$set" BIGINT, "$jsono$spill$0" BIGINT, c4000 BIGINT))))
FROM (SELECT jsono('{"a":1}', shredding := '{"a": "BIGINT"}') AS c);
----
false

# Forged: dirty row whose mask is out of domain (bit 5 with one shred).
query I
SELECT jsono_validate(struct_pack(jsono := struct_pack(
  "body$2" := d.jsono."body$2",
  "shreds$2" := struct_pack(
    "$jsono$set" := d.jsono."shreds$2"."$jsono$set",
    "$jsono$spill$0" := 32::BIGINT,
    c4000 := d.jsono."shreds$2".c4000
  )))::STRUCT(jsono STRUCT("body$2" STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB), "shreds$2" STRUCT("$jsono$set" BIGINT, "$jsono$spill$0" BIGINT, c4000 BIGINT))))
FROM (SELECT jsono('{"a":"oops"}', shredding := '{"a": "BIGINT"}') AS d);
----
false

# Forged: a desynced lane (set lane while the residual still holds the path) is invalid — a set
# lane must mean the path was stripped.
query I
SELECT jsono_validate(struct_pack(jsono := struct_pack(
  "body$2" := jsono('{"a":1}')."jsono"."body$2",
  "shreds$2" := struct_pack(
    "$jsono$set" := c.jsono."shreds$2"."$jsono$set",
    "$jsono$spill$0" := NULL::BIGINT,
    c4000 := 999::BIGINT
  )))::STRUCT(jsono STRUCT("body$2" STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB), "shreds$2" STRUCT("$jsono$set" BIGINT, "$jsono$spill$0" BIGINT, c4000 BIGINT))))
FROM (SELECT jsono('{"a":1}', shredding := '{"a": "BIGINT"}') AS c);
----
false
