# name: test/sql/jsono_malformed_lane_read.test
# description: a non-decoding lane name inside a fully-anchored type makes JSON reads refuse loudly (a catalog-evolution typo would otherwise silently turn the whole column into NULLs); passthrough, ::VARCHAR and DROP COLUMN recovery stay open
# group: [sql]

require jsono

require json

require parquet

statement ok
CREATE TABLE t AS SELECT jsono('{"a":"v1","z":1}', shredding := '{"a": "VARCHAR"}') AS j;

# The evolution typo: adding a lane under the path spelled as text instead of its encoded name.
statement ok
ALTER TABLE t ADD COLUMN j.jsono."shreds$2"."$.b" VARCHAR;

# JSON reads refuse with the grammar's own reason — for every path, including intact lanes and the
# residual, since none of them could be answered correctly.
statement error
SELECT j ->> 'a' FROM t;
----
field '$.b' is not a shred lane

statement error
SELECT j -> 'a' FROM t;
----
field '$.b' is not a shred lane

statement error
SELECT to_json(j) FROM t;
----
field '$.b' is not a shred lane

statement error
SELECT j::JSON FROM t;
----
field '$.b' is not a shred lane

# Type-only near-misses stay silent: that shape is what a legal generic write narrows into.
# (Pinned by the layout-grammar cases; here only the NAME class is loud.)

# Passthrough and the raw render stay open, so backup and recovery work.
query I
SELECT count(*) FROM t;
----
1

statement ok
COPY t TO '__TEST_DIR__/malformed_backup.parquet' (FORMAT parquet);

query I
SELECT (j::VARCHAR) IS NOT NULL FROM t;
----
true

# Recovery by DROP works HERE because the misnamed lane was ADDED empty — it never held stripped
# values (the data-carrying case is below, where a drop is refused by the shred manifest instead).
statement ok
ALTER TABLE t DROP COLUMN j.jsono."shreds$2"."$.b";

query II
SELECT j ->> 'a', j ->> 'z' FROM t;
----
v1	1

# The legal evolution: the same lane added under its encoded name (jsono_storage_type prints it)
# keeps every read working.
statement ok
ALTER TABLE t ADD COLUMN j.jsono."shreds$2".c8000 VARCHAR;

query III
SELECT j ->> 'a', j ->> 'z', j ->> 'b' FROM t;
----
v1	1	NULL

# The same class one level down: an array lane's element SUBFIELD name is minted by the same codec,
# and a legal generic write narrows subfield TYPES while keeping subfield NAMES — so a non-decoding
# subfield name is the same no-legal-writer shape as a non-decoding lane name, marked and refused
# the same way (here "nm!" beside the canonical d5i0000/…).
statement ok
CREATE TABLE sub_src AS SELECT jsono('{"items":[{"id":1,"nm":"a"}],"k":1}',
  shredding := '{"$.items": "STRUCT(id BIGINT, nm VARCHAR)[]"}') AS j;

statement ok
CREATE TABLE sub_bad AS SELECT CAST(j AS STRUCT(jsono STRUCT("body$1" STRUCT(slots BLOB, key_heap BLOB,
  string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB),
  "shreds$2" STRUCT("$jsono$set" BIGINT, "$jsono$spill$0" BIGINT,
  d5q6arbj0000 STRUCT(d5i0000 BIGINT, "nm!" VARCHAR)[])))) AS j FROM sub_src;

statement error
SELECT j ->> 'k' FROM sub_bad;
----
array shred 'd5q6arbj0000' has an element subfield

statement error
SELECT to_json(j) FROM sub_bad;
----
array shred 'd5q6arbj0000' has an element subfield

statement error
SELECT j::JSON FROM sub_bad;
----
array shred 'd5q6arbj0000' has an element subfield

# Passthrough and the raw render stay open here too.
query I
SELECT (j::VARCHAR) IS NOT NULL FROM sub_bad;
----
true

# A JSONO conversion of a misnamed value is refused like the JSON reads: jsono() and the cast to
# JSONO would treat it as an ordinary struct and rebuild the document out of the raw layout fields.
# The INSERT ... SELECT into a plain JSONO column matters most: it LOOKS like the "move the bytes"
# recovery the read error recommends, but it goes through exactly that cast and would destroy the
# data irreversibly.
statement ok
CREATE TABLE lane_src AS SELECT jsono('{"a":1,"b":"x"}', shredding := '{"$.a": "BIGINT"}') AS j;

statement ok
CREATE TABLE lane_bad AS SELECT CAST(j AS STRUCT(jsono STRUCT("body$1" STRUCT(slots BLOB, key_heap BLOB,
  string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB),
  "shreds$2" STRUCT("$jsono$set" BIGINT, "$jsono$spill$0" BIGINT, "$.a" BIGINT)))) AS j FROM lane_src;

statement error
SELECT jsono(j) FROM lane_bad;
----
field '$.a' is not a shred lane

statement ok
CREATE TABLE plain_target AS SELECT jsono('{}') AS v LIMIT 0;

statement error
INSERT INTO plain_target SELECT j FROM lane_bad;
----
field '$.a' is not a shred lane

# The subfield-level miss refuses the conversions too.
statement error
SELECT jsono(j) FROM sub_bad;
----
array shred 'd5q6arbj0000' has an element subfield

statement error
INSERT INTO plain_target SELECT j FROM sub_bad;
----
array shred 'd5q6arbj0000' has an element subfield

# The typical typo is a RENAME of a DATA-CARRYING lane (values were stripped into it), and there
# the recovery the refusal recommends FIRST is renaming BACK to the encoded name: it restores every
# read in place.
statement ok
CREATE TABLE ren AS SELECT jsono('{"a":1,"b":"x"}', shredding := '{"$.a": "BIGINT", "$.b": "VARCHAR"}') AS j;

statement ok
ALTER TABLE ren RENAME COLUMN "j"."jsono"."shreds$2".c8000 TO "$.b";

statement error
SELECT j ->> 'a' FROM ren;
----
field '$.b' is not a shred lane

statement ok
ALTER TABLE ren RENAME COLUMN "j"."jsono"."shreds$2"."$.b" TO c8000;

query I
SELECT to_json(j)::VARCHAR FROM ren;
----
{"a":1,"b":"x"}

# DROP of a data-carrying misnamed lane is NOT a recovery: the stripped values go with it, and the
# shred manifest refuses the narrowed rows — correctly, since the read would silently lose '$.b'.
statement ok
CREATE TABLE dropped AS SELECT jsono('{"a":1,"b":"x"}', shredding := '{"$.a": "BIGINT", "$.b": "VARCHAR"}') AS j;

statement ok
ALTER TABLE dropped RENAME COLUMN "j"."jsono"."shreds$2".c8000 TO "$.b";

statement ok
ALTER TABLE dropped DROP COLUMN "j"."jsono"."shreds$2"."$.b";

statement error
SELECT to_json(j) FROM dropped;
----
no longer carries that shred

# Dropping the ONLY lane leaves `shreds` with reserved fields and no shred — a shape that silently
# stops being JSONO (a type-level miss, deliberately quiet): the diagnosis names it.
statement ok
CREATE TABLE lastlane AS SELECT jsono('{"a":1}', shredding := '{"$.a": "BIGINT"}') AS j;

statement ok
ALTER TABLE lastlane RENAME COLUMN "j"."jsono"."shreds$2".c4000 TO "$.a";

statement ok
ALTER TABLE lastlane DROP COLUMN "j"."jsono"."shreds$2"."$.a";

query II
SELECT x.kind, x.reason FROM (SELECT jsono_layout_diagnose(j) AS x FROM lastlane);
----
not jsono	'shreds$2' carries only reserved layout fields and no shred
