# name: test/sql/jsono_storage_type.test
# description: jsono_storage_type() exposes the physical STRUCT DDL backing JSONO
# group: [sql]

require jsono

require parquet

require json

# The DDL string is the physical STRUCT layout of a jsono value (no type alias exists).
# Changing it is a deliberate format change — update this expectation on purpose.
query I
SELECT jsono_storage_type();
----
STRUCT(jsono STRUCT("body$1" STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB)))

# A column declared with that DDL is structurally a JSONO: jsono ops bind to it
# without an explicit cast, so the round-trip from storage form works.
statement ok
CREATE TABLE t (props STRUCT(jsono STRUCT("body$1" STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB))));

statement ok
INSERT INTO t SELECT jsono('{"a":1}');

query I
SELECT jsono_extract_string(props, '$.a') FROM t;
----
1

# The function emits the *real* storage form, not a separately-maintained string:
# the column is already the physical STRUCT, so Parquet reads it back unchanged,
# and that type must print back to exactly jsono_storage_type().
statement ok
COPY (SELECT jsono('{"a":1}') AS props) TO '__TEST_DIR__/jsono_storage_type.parquet';

query I
SELECT typeof(props) = jsono_storage_type() FROM '__TEST_DIR__/jsono_storage_type.parquet';
----
true

# Boundary of the structural match: a STRUCT that is close but not the exact
# four jsono_* BLOB layout must NOT bind to jsono ops. Guards IsJsonoType against
# accidentally widening (it compares names AND types against JsonoRawStructType).
# The functions accept ANY arg0 (to reach shredded values), so a near-miss struct is
# now rejected in the bind with "argument must be JSONO" rather than at overload resolution.

# Wrong field name (jsono_slot, not jsono_slots).
statement error
SELECT jsono_extract_string({'jsono_slot': ''::BLOB, 'jsono_key_heap': ''::BLOB, 'jsono_string_heap': ''::BLOB, 'jsono_skips': ''::BLOB}, '$.a');
----
jsono_extract_string: argument must be JSONO

# Wrong field type (INTEGER where BLOB is required).
statement error
SELECT jsono_extract_string({'jsono_slots': 0, 'jsono_key_heap': ''::BLOB, 'jsono_string_heap': ''::BLOB, 'jsono_skips': ''::BLOB}, '$.a');
----
jsono_extract_string: argument must be JSONO

# Wrong field count (three BLOBs, not four).
statement error
SELECT jsono_extract_string({'jsono_slots': ''::BLOB, 'jsono_key_heap': ''::BLOB, 'jsono_string_heap': ''::BLOB}, '$.a');
----
jsono_extract_string: argument must be JSONO

# jsono_storage_type(shreds) emits the shredded storage DDL: the 6-blob residual plus one shred
# column per spec entry inside the `shreds` struct. The DDL is byte-identical to the type the
# constructor produces from the same shreds (asserted by equality rather than a hardcoded literal).
query I
SELECT jsono_storage_type('event_name VARCHAR, n BIGINT')
     = typeof(jsono('{}', shredding := {'event_name':'VARCHAR','n':'BIGINT'}));
----
true

# Shred order is canonicalized (sorted by name), so the shredded type is a pure function of the shred
# set: a reversed shred order in the DDL or the spec yields the exact same type, not just a compatible
# one. This keeps jsono_storage_type and CREATE TABLE AS SELECT in lockstep regardless of order.
query I
SELECT jsono_storage_type('n BIGINT, event_name VARCHAR')
     = jsono_storage_type('event_name VARCHAR, n BIGINT')
   AND jsono_storage_type('n BIGINT, event_name VARCHAR')
     = typeof(jsono('{}', shredding := {'event_name':'VARCHAR','n':'BIGINT'}));
----
true

# A column declared from that DDL is a valid storage column for a value shredded on the same
# shreds (CTAS infers the shredded type); the shred reads back transparently through ->>.
statement ok
CREATE TABLE probe_shred AS
SELECT jsono('{"event_name":"page_view","a":1}', shredding := {'event_name':'VARCHAR'}) AS e;

query I
SELECT e ->> 'event_name' FROM probe_shred;
----
page_view

# A value shredded on a different — even fully disjoint — shred set lands losslessly: the
# optimizer rewrites the struct cast into reconstruct + reshred against the column's shred set.
statement ok
INSERT INTO probe_shred SELECT jsono('{"x":"y"}', shredding := {'x':'VARCHAR'});

query I
SELECT to_json(e)::VARCHAR FROM probe_shred ORDER BY 1;
----
{"a":1,"event_name":"page_view"}
{"x":"y"}

# No JSON key is reserved any more. A lane is named by the base32hex encoding of its path, drawn from
# `0-9a-v`, so it can be neither the word `body` (the residual field) nor anything under the reserved
# `$jsono$` prefix — the collision the two former bans guarded against is unrepresentable, and a
# document key spelled like a layout field shreds like any other. (A `$`-leading key still needs its
# quoted `$.`-rooted spelling — that is the spec DSL's own reservation, not the format's.) Both sides
# still agree, which is the point of the shared parse.
query I
SELECT jsono_storage_type('"$.""$jsono$set""" VARCHAR')
     = typeof(jsono('{"$jsono$set":"x"}', shredding := {'$."$jsono$set"':'VARCHAR'}));
----
true

query I
SELECT jsono_storage_type('"$.""$jsono$spill$0""" VARCHAR')
     = typeof(jsono('{"$jsono$spill$0":"x"}', shredding := {'$."$jsono$spill$0"':'VARCHAR'}));
----
true

query I
SELECT jsono_storage_type('body BIGINT') = typeof(jsono('{"body":1}', shredding := {'body':'BIGINT'}));
----
true

# Unsupported shred types are rejected here, not only later by the constructor.
statement error
SELECT jsono_storage_type('a INTEGER');
----
unsupported shred type

statement error
SELECT jsono_storage_type('a JSON');
----
unsupported shred type

# `body` and `$.body` are two spellings of ONE path, so they now name one lane: the DDL helper and the
# constructor agree whichever spelling either is given.
query I
SELECT jsono_storage_type('"$.body" BIGINT') = typeof(jsono('{"body":1}', shredding := {'$.body':'BIGINT'}));
----
true

query I
SELECT jsono_storage_type('"$.body" BIGINT') = jsono_storage_type('body BIGINT');
----
true

# Two columns resolving to one path cannot both be fields of one STRUCT, so the DDL helper refuses
# loudly rather than emit a type it cannot build.
statement error
SELECT jsono_storage_type('body BIGINT, "$.body" BIGINT');
----
name the same shred path

# Every shred path must be an object-key chain, matching the constructor: an array-index step is
# rejected whether the shred type is an array or a scalar.
statement error
SELECT jsono_storage_type('"$.a[0]" STRUCT(id BIGINT)[]');
----
object-key path

query I
SELECT jsono_storage_type('"$.a" STRUCT(id BIGINT)[]')
     = typeof(jsono('{"a":[{"id":1}]}', shredding := {'$.a':'STRUCT(id BIGINT)[]'}));
----
true

query I
SELECT jsono_storage_type('"$.ids" UBIGINT[]')
     = typeof(jsono('{"ids":[1,2]}', shredding := {'$.ids':'UBIGINT[]'}));
----
true

# ---- NULL spec edges ----

# A NULL spec argument folds to SQL NULL (DEFAULT null handling), not an error or a bogus type string.
# The typed NULL::VARCHAR behaves the same.
query I
SELECT jsono_storage_type(NULL) IS NULL AND jsono_storage_type(NULL::VARCHAR) IS NULL;
----
true

# An all-NULL spec column maps every row to NULL — no row fabricates a stray DDL string.
query I
SELECT count(*) FILTER (WHERE jsono_storage_type(s) IS NOT NULL)
FROM (VALUES (NULL::VARCHAR), (NULL::VARCHAR), (NULL::VARCHAR)) t(s);
----
0

# ---- Why the DDL helper exists: a hand-declared column can miss the grammar silently ----

# A lane type the constructor itself rejects (INTEGER is not a shred value type) is still accepted by
# CREATE TABLE, and the value written into it stops being recognizable as JSONO: every read answers
# NULL, including for paths that were never shredded. Nothing is lost — the bytes are intact and one
# cast to the correct lane type brings the whole document back — but nothing warns at write time
# either. Refusing this at write time is not possible without breaking a legal path (a generic
# value->SQL->value round-trip narrows lanes the same way; see docs/jsono_format.md "Layout
# revisions"), so the answer is to declare storage columns with jsono_storage_type().
statement ok
CREATE TABLE hand_declared (v STRUCT(jsono STRUCT("body$1" STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB), "shreds$2" STRUCT("$jsono$set" BIGINT, "$jsono$spill$0" BIGINT, c4000 INTEGER))));

statement ok
INSERT INTO hand_declared SELECT jsono('{"a":1,"b":"x"}', shredding := {'a':'BIGINT'});

query II
SELECT v ->> 'a', v ->> 'b' FROM hand_declared;
----
NULL	NULL

# The same bytes read back in full once the column type matches what the constructor produces.
query I
SELECT to_json(v::STRUCT(jsono STRUCT("body$1" STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB), "shreds$2" STRUCT("$jsono$set" BIGINT, "$jsono$spill$0" BIGINT, c4000 BIGINT))))
FROM hand_declared;
----
{"a":1,"b":"x"}

# Declared with the type the helper emits for the same shred set, the INSERT reads back as written.
statement ok
CREATE TABLE helper_declared (v STRUCT(jsono STRUCT("body$1" STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB), "shreds$2" STRUCT("$jsono$set" BIGINT, "$jsono$spill$0" BIGINT, c4000 BIGINT))));


statement ok
INSERT INTO helper_declared SELECT jsono('{"a":1,"b":"x"}', shredding := {'a':'BIGINT'});

query II
SELECT v ->> 'a', v ->> 'b' FROM helper_declared;
----
1	x

# …and that column type IS what the helper emits for the shred set — the declaration above is the
# helper's own output, not a lucky hand-written match.
query I
SELECT jsono_storage_type('a BIGINT') = typeof(v) FROM helper_declared;
----
true
