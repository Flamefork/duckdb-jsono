# name: test/sql/jsono_layout_golden.test
# description: Golden layout type and golden body bytes — the tripwires for an unannounced format change
# group: [sql]

require jsono

require json

# ---------------------------------------------------------------------------
# GOLDEN TYPE. Written as literals, not as `typeof(x) = jsono_storage_type()`:
# a self-comparison moves along with any change, a literal does not. If one of
# these goes red, the physical layout changed — bump the revision in the field
# name (JSONO_BODY_REVISION / JSONO_SHREDS_REVISION in src/include/jsono.hpp),
# move the golden bytes below into a closed-revision fixture in
# jsono_layout_revision.test, and write the closed revision's full layout into
# docs/jsono_format.md → "Revision history". All three, same commit.
# ---------------------------------------------------------------------------

query I
SELECT jsono_storage_type();
----
STRUCT(jsono STRUCT("body$1" STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB)))

query I
SELECT jsono_storage_type('a BIGINT, b VARCHAR');
----
STRUCT(jsono STRUCT("body$1" STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB), "shreds$1" STRUCT("$jsono$set" BIGINT, "$jsono$spill$0" BIGINT, a BIGINT, b VARCHAR)))

query I
SELECT typeof(jsono('{"a":1}'));
----
STRUCT(jsono STRUCT("body$1" STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB)))

query I
SELECT typeof(jsono('{"a":1,"b":"x"}', shredding := {'a':'BIGINT'}));
----
STRUCT(jsono STRUCT("body$1" STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB), "shreds$1" STRUCT("$jsono$set" BIGINT, "$jsono$spill$0" BIGINT, a BIGINT)))

# The layout name is the permanent anchor: it must never gain a revision suffix, or a value of any
# revision stops being recognizable as JSONO at all (which is what made an old layout read as a bare
# struct instead of failing loud).
query I
SELECT jsono_storage_type() LIKE 'STRUCT(jsono STRUCT(%';
----
true

# ---------------------------------------------------------------------------
# GOLDEN BYTES. The type cannot show a purely semantic change — a different
# spill bit numbering, a different marker value, a different residual encoding
# all keep the type identical and would read silently wrong under a compat
# reader written against the wrong assumption. These literals are what catches
# them. Same checklist as above applies when they go red.
# ---------------------------------------------------------------------------

statement ok
CREATE MACRO body_hex(v) AS concat_ws('|', hex(v.jsono."body$1".slots), hex(v.jsono."body$1".key_heap),
                                      hex(v.jsono."body$1".string_heap), hex(v.jsono."body$1".skips),
                                      hex(v.jsono."body$1".lengths), hex(v.jsono."body$1".nums));

# Plain: the whole document lives in the residual.
query I
SELECT body_hex(jsono('{"a":1,"b":"x"}'));
----
4A534E4F0401000002000000000000000100000000000040010000010000004000000000000000A000000000000000800000000000000010|6162|78|000000000000000000000000|01000000|0100000000000000

# Clean scalar shred: `a` is stripped from the residual (its skips tail carries the shred manifest),
# the marker is the clean layout hash and the spill column stays NULL on a clean row.
query III
SELECT body_hex(v), v.jsono."shreds$1"."$jsono$set", v.jsono."shreds$1"."$jsono$spill$0"
FROM (SELECT jsono('{"a":1,"b":"x"}', shredding := {'a':'BIGINT'}) AS v);
----
4A534E4F040100000100000000000000010000000000004000000000000000800000000000000010|62|78|000000000000000000000000FFFFFFFF0100000001006102|01000000|	284599021030007636	NULL

# Dirty row (a container at the shred path diverts into the residual): the lane is NULL, the whole
# document stays in the residual, the marker is the clean hash with its lowest bit flipped and the
# spill column carries the diverted shred's rank bit. Marker and mask are the semantics no type can
# express — this row is the reason golden bytes exist.
query IIII
SELECT body_hex(v), v.jsono."shreds$1"."$jsono$set", v.jsono."shreds$1"."$jsono$spill$0",
       v.jsono."shreds$1".a IS NULL
FROM (SELECT jsono('{"a":{"n":1},"b":"x"}', shredding := {'a':'BIGINT'}) AS v);
----
4A534E4F040100000200000000000000010000000000004001000001000000400100000100000000010000020000004000000000000000A0000000000000001000000000000000800000000000000010|61626E|78|000000000000000000000000|01000000|0100000000000000	284599021030007637	1	true

# The dirty marker is exactly the clean marker with bit 0 flipped — the two-valued stamp every
# totality proof reads as a plain min/max question.
query I
SELECT xor((SELECT v.jsono."shreds$1"."$jsono$set" FROM (SELECT jsono('{"a":{"n":1},"b":"x"}', shredding := {'a':'BIGINT'}) AS v)),
           (SELECT v.jsono."shreds$1"."$jsono$set" FROM (SELECT jsono('{"a":1,"b":"x"}', shredding := {'a':'BIGINT'}) AS v))) = 1;
----
true

# Nested lane: the residual keeps the object skeleton, the leaf is stripped.
query III
SELECT body_hex(v), v.jsono."shreds$1"."$jsono$set", v.jsono."shreds$1"."$jsono$spill$0"
FROM (SELECT jsono('{"o":{"k":"v"}}', shredding := {'$.o.k':'VARCHAR'}) AS v);
----
4A534E4F0401000001000000000000000100000000000040000000010000000000000000000000100000000000000010|6F||000000000000000000000000FFFFFFFF010000000500242E6F2E6B01||	7598230814825901478	NULL

# Scalar array lane: the residual keeps one VAL_NULL placeholder per lifted element; an array shred
# is never bare-read, so it never sets a spill bit.
query IIII
SELECT body_hex(v), v.jsono."shreds$1"."$jsono$set", v.jsono."shreds$1"."$jsono$spill$0",
       v.jsono."shreds$1"."$.p"::VARCHAR
FROM (SELECT jsono('{"p":[1,2]}', shredding := {'$.p':'BIGINT[]'}) AS v);
----
4A534E4F040100000100000000000000010000000000004000000001000000200000000000000050000000000000005000000000000000300000000000000010|70||01000000000000000000000001000000040000000000000000000000000000000000000000000000FFFFFFFF010000000300242E7007||	965310507769059411	NULL	[1, 2]

# A SQL-NULL row nulls the whole value, marker and spill columns included.
query III
SELECT v IS NULL, v.jsono."shreds$1"."$jsono$set" IS NULL, v.jsono."shreds$1"."$jsono$spill$0" IS NULL
FROM (SELECT jsono(NULL::VARCHAR, shredding := {'a':'BIGINT'}) AS v);
----
true	true	true

# The blob encoding version is versioned separately from the layout: it describes the bytes INSIDE
# the body blobs, which the golden bytes above pin.
query I
SELECT jsono_version();
----
4
