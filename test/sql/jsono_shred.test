# name: test/sql/jsono_shred.test
# description: jsono(value, shredding := spec) — one-pass lossless conditional strip into shredded JSONO
# group: [sql]

require jsono

require json

# Peek the raw residual tape: the body blobs repacked as a plain jsono with the shreds dropped.
# This is the white-box view of what shredding stripped — distinct from casting a shredded
# value to the plain jsono STRUCT, which losslessly reconstructs by overlaying the shreds.
# The residual alone is an internal fragment: its shred manifest lists the stripped paths and the
# plain repack carries no shreds to cover them, so whole-value readers (to_json) fail loud on a
# stripped row, and only path reads away from the stripped paths still answer. Both behaviors are
# asserted below as the white-box evidence of what was stripped vs kept.
statement ok
CREATE MACRO jsono_residual(j) AS struct_pack(
    "jsono" := struct_pack(
        "body$2" := struct_extract_at(struct_extract_at(j, 1), 1)));

# jsono(j, shredding := spec) returns the shredded STRUCT: six blob residual + one shred per
# spec path (named by the encoding of the path, typed by the spec). The read side reconstructs
# the original value, so to_json round-trips losslessly.

# All-string shreds: both strip (a string round-trips through a VARCHAR shred), so the
# residual is empty and the values live only in the shreds.
query I
SELECT to_json(jsono('{"did":"d1","kind":"commit"}', shredding := '{"$.kind": "VARCHAR", "$.did": "VARCHAR"}'));
----
{"did":"d1","kind":"commit"}

statement error
SELECT to_json(jsono_residual(jsono('{"did":"d1","kind":"commit"}', shredding := '{"$.kind": "VARCHAR", "$.did": "VARCHAR"}')));
----
row was shredded with shred '$.did VARCHAR'

# Typed shred: a BIGINT path strips and reconstructs as a JSON number; the residual
# keeps only the non-hot key.
query I
SELECT to_json(jsono('{"extra":"e1","kind":"commit","time_us":1700}', shredding := '{"$.kind": "VARCHAR", "$.time_us": "BIGINT"}'));
----
{"extra":"e1","kind":"commit","time_us":1700}

statement error
SELECT to_json(jsono_residual(jsono('{"extra":"e1","kind":"commit","time_us":1700}', shredding := '{"$.kind": "VARCHAR", "$.time_us": "BIGINT"}')));
----
row was shredded with shred '$.kind VARCHAR'

# The non-hot key stays in the residual and still reads there (the extract manifest check is
# path-granular: only the stripped paths are barred).
query I
SELECT jsono_residual(jsono('{"extra":"e1","kind":"commit","time_us":1700}', shredding := '{"$.kind": "VARCHAR", "$.time_us": "BIGINT"}')) ->> '$.extra';
----
e1

query I
SELECT CAST(jsono('{"time_us":1700}', shredding := '{"$.time_us": "BIGINT"}') ->> '$.time_us' AS BIGINT);
----
1700

# Heterogeneous: a string in a BIGINT-typed shred does not fit, so it is kept in the
# residual (shred NULL) and the read falls back to the residual. Round-trip is faithful.
query I
SELECT to_json(jsono('{"n":"hello"}', shredding := '{"$.n": "BIGINT"}'));
----
{"n":"hello"}

query I
SELECT jsono('{"n":"hello"}', shredding := '{"$.n": "BIGINT"}') ->> '$.n';
----
hello

# A number in a VARCHAR shred: the shred holds the ->> text for reads, but the value is
# not a string so it is not stripped — the residual keeps the number for a faithful
# round-trip.
query I
SELECT to_json(jsono('{"k":5}', shredding := '{"$.k": "VARCHAR"}'));
----
{"k":5}

query I
SELECT jsono('{"k":5}', shredding := '{"$.k": "VARCHAR"}') ->> '$.k';
----
5

# An explicit JSON null is kept (a null is not a string), so it survives reconstruction.
query I
SELECT to_json(jsono('{"a":null,"b":"x"}', shredding := '{"$.a": "VARCHAR"}'));
----
{"a":null,"b":"x"}

# Nested paths strip too: a nested string shred leaves its leaf out of the residual and
# is refilled from the shred on reconstruction, so the full value round-trips intact.
query I
SELECT to_json(jsono('{"commit":{"collection":"c1","operation":"create"},"kind":"commit"}', shredding := '{"$.kind": "VARCHAR", "$.commit.operation": "VARCHAR"}'));
----
{"commit":{"collection":"c1","operation":"create"},"kind":"commit"}

# The residual keeps the surrounding object but drops the stripped nested leaf: the kept sibling
# still reads, the whole value does not.
query I
SELECT jsono_residual(jsono('{"commit":{"collection":"c1","operation":"create"},"kind":"commit"}', shredding := '{"$.kind": "VARCHAR", "$.commit.operation": "VARCHAR"}')) ->> '$.commit.collection';
----
c1

statement error
SELECT to_json(jsono_residual(jsono('{"commit":{"collection":"c1","operation":"create"},"kind":"commit"}', shredding := '{"$.kind": "VARCHAR", "$.commit.operation": "VARCHAR"}')));
----
row was shredded with shred '$.commit.operation VARCHAR'

query I
SELECT jsono('{"commit":{"operation":"create"},"kind":"commit"}', shredding := '{"$.kind": "VARCHAR", "$.commit.operation": "VARCHAR"}') ->> '$.commit.operation';
----
create

# Deep nesting: a third-level string leaf strips from the residual and round-trips.
query I
SELECT to_json(jsono('{"commit":{"record":{"text":"hi","langs":["en"]},"rev":"r1"}}', shredding := '{"$.commit.record.text": "VARCHAR", "$.commit.rev": "VARCHAR"}'));
----
{"commit":{"record":{"langs":["en"],"text":"hi"},"rev":"r1"}}

statement error
SELECT to_json(jsono_residual(jsono('{"commit":{"record":{"text":"hi","langs":["en"]},"rev":"r1"}}', shredding := '{"$.commit.record.text": "VARCHAR", "$.commit.rev": "VARCHAR"}')));
----
row was shredded with shred '$.commit.record.text VARCHAR'

query I
SELECT jsono_residual(jsono('{"commit":{"record":{"text":"hi","langs":["en"]},"rev":"r1"}}', shredding := '{"$.commit.record.text": "VARCHAR", "$.commit.rev": "VARCHAR"}')) ->> '$.commit.record.langs';
----
["en"]

# Stripping the only key of a nested object leaves it empty in the residual; the shred
# refills it on reconstruction (asserted by the round-trip below), and the residual alone
# fails loud on its stripped leaf.
statement error
SELECT to_json(jsono_residual(jsono('{"commit":{"record":{"text":"only"}}}', shredding := '{"$.commit.record.text": "VARCHAR"}')));
----
row was shredded with shred '$.commit.record.text VARCHAR'

query I
SELECT to_json(jsono('{"commit":{"record":{"text":"only"}}}', shredding := '{"$.commit.record.text": "VARCHAR"}'));
----
{"commit":{"record":{"text":"only"}}}

# A nested non-string value is not lossless through a VARCHAR shred, so it stays in the
# residual (read-accelerated, not stripped).
query I
SELECT to_json(jsono_residual(jsono('{"commit":{"seq":42}}', shredding := '{"$.commit.seq": "VARCHAR"}')));
----
{"commit":{"seq":42}}

# A row missing the nested parent must not gain a spurious empty object: the all-absent
# shreds contribute nothing, so the value round-trips to exactly its original shape.
query I
SELECT to_json(jsono('{"kind":"account","did":"d2"}', shredding := '{"$.kind": "VARCHAR", "$.commit.operation": "VARCHAR", "$.commit.cid": "VARCHAR"}'));
----
{"did":"d2","kind":"account"}

# A json-valued read of a subtree holding a stripped nested leaf must reconstruct, so the
# returned subtree is complete — not the residual's stripped copy.
query I
SELECT jsono('{"commit":{"cid":"X","operation":"create"}}', shredding := '{"$.commit.cid": "VARCHAR"}') -> '$.commit';
----
{"cid":"X","operation":"create"}

# A NULL input shreds to NULL.
query I
SELECT to_json(jsono(NULL, shredding := '{"$.kind": "VARCHAR"}'));
----
NULL

# Multi-row over a table, including a NULL row and a missing hot path.
statement ok
CREATE TABLE docs AS
SELECT * FROM (VALUES
    (1, '{"did":"d1","kind":"commit","time_us":10}'),
    (2, '{"did":"d2","kind":"account"}'),
    (3, NULL)
) AS v(id, doc);

query ITT
SELECT id,
       to_json(jsono(doc, shredding := '{"$.kind": "VARCHAR", "$.did": "VARCHAR", "$.time_us": "BIGINT"}')) AS full,
       jsono(doc, shredding := '{"$.kind": "VARCHAR", "$.did": "VARCHAR", "$.time_us": "BIGINT"}') ->> '$.kind' AS kind
FROM docs ORDER BY id;
----
1	{"did":"d1","kind":"commit","time_us":10}	commit
2	{"did":"d2","kind":"account"}	account
3	NULL	NULL

# Secondary form: jsono(<already-jsono>, shredding := spec) shreds a value that is already plain
# jsono (the inner jsono() parses, the outer shreds — equivalent to the text form).
query I
SELECT to_json(jsono(jsono('{"did":"d1","kind":"commit"}'), shredding := '{"$.kind": "VARCHAR"}'));
----
{"did":"d1","kind":"commit"}

query I
SELECT jsono(jsono('{"k":7}'), shredding := '{"$.k": "BIGINT"}') ->> '$.k';
----
7

# shredding is a named argument: a bare positional spec is rejected.
statement error
SELECT jsono('{"a":1}', {'$.a':'BIGINT'});
----
unknown argument

# A type string DuckDB's own parser refuses carries the parser's reason, not a bare "unsupported":
# here the reason is the actual defect — SQL type text folds STRUCT field names case-insensitively,
# so an element struct with case-colliding subfields cannot ride through the spec at all (the
# paste-back limit README documents under jsono_layout_lanes). jsono_suggest_shredding emits exactly
# this spec over documents whose element keys collide, so the refusal must point at the collision.
statement error
SELECT jsono('{"products":[{"id":1,"ID":"x"}]}', shredding := '{"$.products": "STRUCT(ID VARCHAR, id BIGINT)[]"}');
----
Duplicate STRUCT type argument name

# An unknown type name and unparseable type text propagate their reasons the same way.
statement error
SELECT jsono('{"a":1}', shredding := '{"a": "BIGIN"}');
----
Type with name BIGIN does not exist

statement error
SELECT jsono('{"a":1}', shredding := '{"a": "STRUCT(("}');
----
can not be converted to a DuckDB Type

# The JSON spec carrier's own bind-time refusals: each wrong shape of the spec is a distinct,
# explicit error. The carrier is the most-used declaration surface, so every arm of its grammar
# is pinned — a STRUCT literal (the removed carrier), SQL NULL, non-JSON text, a JSON array,
# a non-string type value, a nested object where a type string belongs, and an empty object.
statement error
SELECT jsono('{"a":1}', shredding := {'a': 'BIGINT'});
----
shredding spec must be a non-NULL JSON object

statement error
SELECT jsono('{"a":1}', shredding := NULL);
----
shredding spec must be a non-NULL JSON object

statement error
SELECT jsono('{"a":1}', shredding := '{not json');
----
shredding spec is not valid JSON

statement error
SELECT jsono('{"a":1}', shredding := '["a"]');
----
must be a JSON object mapping path to type

statement error
SELECT jsono('{"a":1}', shredding := '{"a": 1}');
----
type for 'a' must be a JSON string naming the shred type

statement error
SELECT jsono('{"a":1}', shredding := '{"a": {"b": "BIGINT"}}');
----
type for 'a' must be a JSON string naming the shred type

statement error
SELECT jsono('{"a":1}', shredding := '{}');
----
empty shredding spec

# A BYTE-EXACT duplicate key refuses like the two-spellings duplicate: the spec is a declaration,
# not a document. In a document last-wins is the JSON rule and jsono values keep it
# (jsono_dupkey_shredded.test); of two contradicting declarations neither is "fresher", and specs
# are emitted programmatically (jsono_suggest_shredding), so a duplicate key is a generator bug to
# surface, not a preference to honor.
statement error
SELECT jsono('{"a":1}', shredding := '{"a": "BIGINT", "a": "VARCHAR"}');
----
name the same shred path

# Values keep last-wins (the document rule) — only the spec refuses.
query I
SELECT to_json(jsono('{"a":1,"a":2}', shredding := '{"$.a": "BIGINT"}'));
----
{"a":2}

# A shred path must be a non-empty object-key chain. An array-index step, a nested index, and the
# root '$' are rejected at bind: otherwise the value would be lifted into a lane while ALSO staying
# in the residual (a read-copy), and every reconstruct-based reader would throw on the non-key lane.
# These bind errors also pin the jsono_entries duplication regression — an index-path leaf can never
# appear both in a lane and in the residual because the spec is unconstructible.
statement error
SELECT jsono('{"arr":[7,8]}', shredding := '{"$.arr[0]": "BIGINT"}');
----
object-key path

statement error
SELECT jsono('{"x":1}', shredding := '{"$": "VARCHAR"}');
----
object-key path

statement error
SELECT jsono('{"a":[{"b":1}]}', shredding := '{"$.a[0].b": "BIGINT"}');
----
object-key path

# A bare '$[0]' is malformed JSONPath (an index with no preceding key) and stays rejected as such.
statement error
SELECT jsono('{"a":[7]}', shredding := '{"$[0]": "BIGINT"}');
----
invalid path

# Layout recognition enforces the same rule on stored/cast structs, and the codec makes it
# structural: an index step has no encoding, so a lane naming one cannot be spelled at all. What
# reaches recognition is simply a name that decodes to nothing — `$.arr[0]` is not base32hex — and
# such a struct is not recognized as JSONO, so jsono functions refuse it at bind instead of reading
# a read-copy lane. The same layout with the encoded object-key lane is recognized and binds.
statement ok
CREATE TABLE bad_lane_layout(x STRUCT(jsono STRUCT("body$2" STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB), "shreds$2" STRUCT("$jsono$set" BIGINT, "$jsono$spill$0" BIGINT, "$.arr[0]" BIGINT))));

statement error
SELECT jsono_array_length(x) FROM bad_lane_layout;
----
must be JSONO

statement ok
CREATE TABLE good_lane_layout(x STRUCT(jsono STRUCT("body$2" STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB), "shreds$2" STRUCT("$jsono$set" BIGINT, "$jsono$spill$0" BIGINT, c5p74000 BIGINT))));

query I
SELECT count(*) FROM (SELECT jsono_array_length(x) FROM good_lane_layout);
----
0

statement ok
DROP TABLE bad_lane_layout;

statement ok
DROP TABLE good_lane_layout;

# No JSON key is reserved by the storage layout, and now not even by its spelling: a lane is named
# by the base32hex encoding of its path, which can be neither a layout field name nor anything under
# the `$jsono$` prefix, so 'body' shreds bare like any other key.
query IIIIII
SELECT to_json(j), j ->> 'jsono_slots', j ->> 'jsono_slots_extra', j ->> 'body', j ->> 'shreds', j ->> 'jsono'
FROM (
  SELECT jsono('{"jsono_slots":"v1","jsono_slots_extra":"v2","body":"v3","shreds":"v4","jsono":"v5"}',
               shredding := '{"jsono_slots": "VARCHAR", "body": "VARCHAR", "shreds": "VARCHAR"}') AS j
);
----
{"body":"v3","jsono":"v5","jsono_slots":"v1","jsono_slots_extra":"v2","shreds":"v4"}	v1	v2	v3	v4	v5

# jsono(struct) lifts top-level scalar fields of shred types into shreds directly (no spec):
# scalars of shred types become columns (narrow ints promote to BIGINT, incl. one level down the
# nested descend), the rest stays in the residual tape. The type is the same one
# jsono_storage_type builds from the same shreds (asserted by struct-type equality).
query I
SELECT typeof(jsono({'a': 1::BIGINT, 'name': 'x', 'nested': {'k': 2}}))
     = jsono_storage_type('{"a": "BIGINT", "name": "VARCHAR", "$.nested.k": "BIGINT"}');
----
true

# the shreds carry the values and to_json round-trips the whole document (incl nested tape)
query III
SELECT s ->> 'a', s ->> 'name', to_json(s) FROM (
  SELECT jsono({'a': 1::BIGINT, 'name': 'x', 'nested': {'k': 2}}) AS s
);
----
1	x	{"a":1,"name":"x","nested":{"k":2}}

# Same reconstruct path when the only residual key is a non-object container — a list, then a
# JSON subtree. Lifting the lone top-level scalar leaves a single-key residual, which the
# to_json overlay must round-trip whole rather than mis-walking the residual tape.
query II
SELECT s ->> 'k', to_json(s) FROM (
  SELECT jsono({'k': 'c', 'tags': [1::BIGINT, 2::BIGINT]}) AS s
);
----
c	{"k":"c","tags":[1,2]}

query II
SELECT s ->> 'k', to_json(s) FROM (
  SELECT jsono({'k': 'c', 'raw': '{"z":1}'::JSON}) AS s
);
----
c	{"k":"c","raw":{"z":1}}

# the struct constructor lifts top-level shred-typed scalars, promoting narrow ints: INTEGER `a`
# lifts as a BIGINT shred alongside the VARCHAR `name`.
query I
SELECT typeof(jsono({'a': 1, 'name': 'x'}))
     = jsono_storage_type('{"a": "BIGINT", "name": "VARCHAR"}');
----
true

# the shredded value still round-trips the whole document through to_json
query I
SELECT to_json(jsono({'a': 1, 'name': 'x'}));
----
{"a":1,"name":"x"}

# Constant reconstruction with every field lifted (empty residual): the constant-folded
# to_json copies the shredded constructor, so the bind-data shreds must survive the copy or
# the shred children are left uninitialized. All keys lift, so the residual is {} and the
# whole document must still rebuild from the shreds.
query I
SELECT to_json(jsono({'name': 'x', 'k': 'y'}));
----
{"k":"y","name":"x"}

statement error
SELECT to_json(jsono_residual(jsono({'name': 'x', 'k': 'y'})));
----
row was shredded with shred '$.k VARCHAR'

# Casting a shredded value to the plain jsono STRUCT is LOSSLESS: it reconstructs the full
# document (overlay the shreds back onto the residual), it does not expose the stripped
# residual (which jsono_residual above shows holds neither key).
query I
SELECT to_json(jsono({'name': 'x', 'k': 'y'})::STRUCT(jsono STRUCT("body$2" STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB))));
----
{"k":"y","name":"x"}

# A nested-path shred round-trips through the reconstruct cast too.
query I
SELECT to_json(jsono('{"commit":{"operation":"create"},"kind":"k"}', shredding := '{"$.commit.operation": "VARCHAR", "$.kind": "VARCHAR"}')::STRUCT(jsono STRUCT("body$2" STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB))));
----
{"commit":{"operation":"create"},"kind":"k"}

# Storing a shredded value into a plain jsono STRUCT column preserves the shred data (the
# implicit cast reconstructs); the shreds must not be silently dropped.
statement ok
CREATE TABLE plain_store (params STRUCT(jsono STRUCT("body$2" STRUCT(slots BLOB, key_heap BLOB, string_heap BLOB, skips BLOB, lengths BLOB, nums BLOB))));

statement ok
INSERT INTO plain_store SELECT jsono({'a': 'x', 'b': 5::BIGINT, 'c': 'y'});

query I
SELECT to_json(params) FROM plain_store;
----
{"a":"x","b":5,"c":"y"}

# The key 'body' is an ordinary key: its lane is named by the encoding of the path, which cannot be
# the residual's field name, so the two spellings that used to be one ban and one workaround are now
# one lane, and jsono({...}) auto-shred lifts it like any other field.
query II
SELECT to_json(jsono('{"body":"x","a":"y"}', shredding := '{"body": "VARCHAR"}')),
       jsono('{"body":"x","a":"y"}', shredding := '{"body": "VARCHAR"}') ->> 'body';
----
{"a":"y","body":"x"}	x

query I
SELECT jsono('{"body":"x","a":"y"}', shredding := '{"body": "VARCHAR"}')
     = jsono('{"body":"x","a":"y"}', shredding := '{"$.body": "VARCHAR"}');
----
true

query II
SELECT typeof(jsono({'body': 'x', 'a': 'y'})) LIKE '%c9nm8u8000 VARCHAR%',
       to_json(jsono({'body': 'x', 'a': 'y'}));
----
true	{"a":"y","body":"x"}

# Reshredding to a smaller or retyped shred set is lossless: dropped shreds fold back into the
# residual (single-pass partial overlay), a retyped shred returns and re-extracts at its new type,
# and a row whose values never left the residual carries no stale manifest from its neighbours.
query I
SELECT to_json(jsono(jsono('{"a":"1","b":"2","c":"3","d":4}', shredding := '{"a": "VARCHAR", "b": "VARCHAR", "c": "VARCHAR"}'),
                     shredding := '{"a": "VARCHAR"}'));
----
{"a":"1","b":"2","c":"3","d":4}

query II
SELECT to_json(jsono(jsono('{"a":7,"b":"x"}', shredding := '{"a": "VARCHAR"}'), shredding := '{"a": "BIGINT"}')),
       jsono(jsono('{"a":7,"b":"x"}', shredding := '{"a": "VARCHAR"}'), shredding := '{"a": "BIGINT"}')."jsono"."shreds$2".c4000;
----
{"a":7,"b":"x"}	7

query I
SELECT to_json(jsono(e, shredding := '{"a": "VARCHAR"}'))::VARCHAR FROM (
  SELECT jsono(j, shredding := '{"a": "VARCHAR", "b": "VARCHAR"}') AS e
  FROM (VALUES ('{"a":"s1","b":"s2"}'), ('{"a":7,"b":8}'), ('{"x":"noshreds"}')) t(j)
) ORDER BY 1;
----
{"a":"s1","b":"s2"}
{"a":7,"b":8}
{"x":"noshreds"}

query I
SELECT to_json(jsono(jsono('{"p":{"q":"deep"},"r":"top"}', shredding := '{"$.p.q": "VARCHAR"}'),
                     shredding := '{"r": "VARCHAR"}'));
----
{"p":{"q":"deep"},"r":"top"}

# Two spec entries naming the same key path ('a' and '$.a') are now one lane, so they cannot both be
# fields of one STRUCT and the spec is refused. The old behaviour (two lanes, both filled, the key
# stripped once) existed only because the spelling leaked into the field name; with the name derived
# from the path there is nothing left to distinguish the two entries by.
statement error
SELECT jsono('{"a":"v","z":1}', shredding := '{"a": "VARCHAR", "$.a": "VARCHAR"}');
----
name the same shred path

# A UBIGINT shred strips values past int64 range and plain non-negative integers alike.
query III
SELECT to_json(j), j."jsono"."shreds$2".c9kme000, j."jsono"."shreds$2".edmm2r3c0000
FROM (SELECT jsono('{"big":18446744073709551615,"small":7}', shredding := '{"big": "UBIGINT", "small": "UBIGINT"}') AS j);
----
{"big":18446744073709551615,"small":7}	18446744073709551615	7
